# Install in /etc/nginx/conf.d/pi-web.conf after replacing the server name
# and certificate paths. This file must be included from nginx's http block.
map $http_upgrade $pi_web_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 25224 ssl;
    server_name pi.example.com;

    ssl_certificate     /etc/nginx/tls/pi-web/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/pi-web/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:PI_WEB_TLS:10m;
    ssl_session_timeout 1d;

    client_max_body_size 100m;

    location = /pi-web-ca.crt {
        alias /var/lib/pi-web-public-ca/pi-web-ca.crt;
        default_type application/x-x509-ca-cert;
        add_header Content-Disposition 'attachment; filename="pi-web-ca.crt"' always;
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        proxy_pass http://127.0.0.1:8024;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $pi_web_connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}
