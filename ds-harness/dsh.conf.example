# Copy this file to dsh.conf and update the values for your environment.
# port 是对外 HTTPS 端口，由 token 反向代理监听；dsh web 只绑定本机回环地址。
port=25228
server_ip=10.30.0.25
# PEM 证书链和无口令私钥；相对路径以本目录为基准，证书 SAN 须匹配 server_ip。
tls_cert=tls/fullchain.pem
tls_key=tls/privkey.pem
# dsh_web_run.sh start 会从启动 URL 提取并安全更新此值。
dsh_token=''
