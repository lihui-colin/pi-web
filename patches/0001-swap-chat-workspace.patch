+++ b/src/client/src/components/PiWebApp.panelLayout.test.ts
@@ -0,0 +1,116 @@
+// @vitest-environment happy-dom
+
+import { render } from "lit";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { readPanelLayoutPreference, writePanelLayoutPreference } from "../panelLayoutPreference";
+import { createCoreActions } from "../plugins/core/actions";
+import type { PluginRuntimeContext } from "../plugins/types";
+import { PiWebApp } from "./PiWebApp";
+import { AppPanelEdgeControl } from "./appShell/AppPanelEdgeControl";
+
+beforeEach(() => {
+  mockDesktopLayout(true);
+});
+
+afterEach(() => {
+  document.body.replaceChildren();
+  localStorage.clear();
+  sessionStorage.clear();
+  vi.restoreAllMocks();
+});
+
+describe("panel layout action", () => {
+  it("swaps and persists the shell layout without replacing its surfaces", async () => {
+    const app = new PiWebApp();
+    // Render the shell without starting the application's network lifecycle.
+    const container = document.createElement("div");
+    document.body.append(container);
+    Object.defineProperty(app, "renderRoot", { value: container });
+    render(app.render(), container);
+    const main = container.querySelector("main");
+    const workspace = container.querySelector("workspace-panel");
+    expect(main).not.toBeNull();
+    expect(workspace).not.toBeNull();
+    expect(container.querySelector(".shell.panels-swapped")).toBeNull();
+
+    const createContext: unknown = Reflect.get(app, "createPluginRuntimeContext");
+    if (!isContextFactory(createContext)) throw new Error("Missing plugin context factory");
+    const context = createContext.call(app);
+    const action = createCoreActions().find((entry) => entry.id === "layout.swap-chat-workspace");
+    if (action === undefined) throw new Error("Missing layout action");
+    await action.run(context);
+    render(app.render(), container);
+    expect(container.querySelector(".shell.panels-swapped")).not.toBeNull();
+    expect(readPanelLayoutPreference()).toBe("workspace-main");
+    expect(container.querySelector("main")).toBe(main);
+    expect(container.querySelector("workspace-panel")).toBe(workspace);
+
+    await action.run(context);
+    render(app.render(), container);
+    expect(container.querySelector(".shell.panels-swapped")).toBeNull();
+    expect(readPanelLayoutPreference()).toBe("chat-main");
+    expect(container.querySelector("main")).toBe(main);
+    expect(container.querySelector("workspace-panel")).toBe(workspace);
+  });
+
+  it("disables swapping in tab layouts and preserves the desktop preference", async () => {
+    writePanelLayoutPreference("workspace-main");
+    const app = new PiWebApp();
+    const createContext: unknown = Reflect.get(app, "createPluginRuntimeContext");
+    if (!isContextFactory(createContext)) throw new Error("Missing plugin context factory");
+    const context = createContext.call(app);
+    const action = createCoreActions().find((entry) => entry.id === "layout.swap-chat-workspace");
+    if (action === undefined) throw new Error("Missing layout action");
+    expect(action.enabled?.(context)).toBe(true);
+
+    mockDesktopLayout(false);
+    expect(action.enabled?.(context)).toBe(false);
+    expect(action.disabledReason?.(context)).toContain("tool tabs");
+    // A stale action/context must also be safe after resizing into a tab layout.
+    await action.run(context);
+    expect(readPanelLayoutPreference()).toBe("workspace-main");
+    expect(Reflect.get(app, "panelLayout")).toBe("workspace-main");
+
+    mockDesktopLayout(true);
+    expect(action.enabled?.(context)).toBe(true);
+    await action.run(context);
+    expect(readPanelLayoutPreference()).toBe("chat-main");
+  });
+
+  it("restores the saved layout in a new app", () => {
+    writePanelLayoutPreference("workspace-main");
+    const app = new PiWebApp();
+    const container = document.createElement("div");
+    document.body.append(container);
+    Object.defineProperty(app, "renderRoot", { value: container });
+    render(app.render(), container);
+    expect(container.querySelector(".shell.panels-swapped")).not.toBeNull();
+  });
+
+  it.each([true, false])("starts resizing from the physical right surface (desktop=%s)", (desktop) => {
+    writePanelLayoutPreference("workspace-main");
+    mockDesktopLayout(desktop);
+    const app = new PiWebApp();
+    const container = document.createElement("div");
+    document.body.append(container);
+    Object.defineProperty(app, "renderRoot", { value: container });
+    render(app.render(), container);
+    const main = container.querySelector("main");
+    const workspace = container.querySelector("workspace-panel");
+    const edge = container.querySelector('app-panel-edge-control[side="workspace"]');
+    if (!main || !workspace || !(edge instanceof AppPanelEdgeControl)) throw new Error("Missing shell surfaces");
+    vi.spyOn(main, "getBoundingClientRect").mockReturnValue(new DOMRect(0, 0, 480, 900));
+    vi.spyOn(workspace, "getBoundingClientRect").mockReturnValue(new DOMRect(0, 0, 720, 900));
+    expect(edge.onResizeStart?.()).toBe(desktop ? 480 : 720);
+  });
+});
+
+function isContextFactory(value: unknown): value is () => PluginRuntimeContext {
+  return typeof value === "function";
+}
+
+function mockDesktopLayout(desktop: boolean): void {
+  const result = window.matchMedia("(min-width: 1181px)");
+  Object.defineProperty(result, "matches", { configurable: true, value: desktop });
+  vi.spyOn(window, "matchMedia").mockReturnValue(result);
+}
