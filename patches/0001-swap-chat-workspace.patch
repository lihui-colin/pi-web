+++ b/src/client/src/panelLayoutPreference.test.ts
@@ -0,0 +1,39 @@
+// @vitest-environment happy-dom
+
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { readPanelLayoutPreference, writePanelLayoutPreference } from "./panelLayoutPreference";
+
+afterEach(() => {
+  localStorage.clear();
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+});
+
+describe("panel layout preference", () => {
+  it("defaults to chat-main for missing or invalid preferences", () => {
+    expect(readPanelLayoutPreference()).toBe("chat-main");
+    localStorage.setItem("pi-web:panel-layout", "invalid");
+    expect(readPanelLayoutPreference()).toBe("chat-main");
+  });
+
+  it("persists both layouts across reads", () => {
+    writePanelLayoutPreference("workspace-main");
+    expect(readPanelLayoutPreference()).toBe("workspace-main");
+    writePanelLayoutPreference("chat-main");
+    expect(readPanelLayoutPreference()).toBe("chat-main");
+  });
+
+  it("tolerates unavailable browser storage", () => {
+    vi.stubGlobal("localStorage", undefined);
+    expect(readPanelLayoutPreference()).toBe("chat-main");
+    expect(() => { writePanelLayoutPreference("workspace-main"); }).not.toThrow();
+    vi.unstubAllGlobals();
+  });
+
+  it("tolerates blocked reads and quota failures", () => {
+    vi.spyOn(localStorage, "getItem").mockImplementation(() => { throw new Error("blocked"); });
+    vi.spyOn(localStorage, "setItem").mockImplementation(() => { throw new Error("quota"); });
+    expect(readPanelLayoutPreference()).toBe("chat-main");
+    expect(() => { writePanelLayoutPreference("workspace-main"); }).not.toThrow();
+  });
+});
diff --git a/src/client/src/panelLayoutPreference.ts b/src/client/src/panelLayoutPreference.ts
new file mode 100644
index 0000000000000000000000000000000000000000..30c1b02d316761e0a5ef4feba44cbb2c3d0d7f72
--- /dev/null
+++ b/src/client/src/panelLayoutPreference.ts
@@ -0,0 +1,27 @@
+export type PanelLayout = "chat-main" | "workspace-main";
+
+const storageKey = "pi-web:panel-layout";
+
+function browserStorage(): Storage | undefined {
+  try {
+    return typeof localStorage === "undefined" ? undefined : localStorage;
+  } catch {
+    return undefined;
+  }
+}
+
+export function readPanelLayoutPreference(storage = browserStorage()): PanelLayout {
+  try {
+    return storage?.getItem(storageKey) === "workspace-main" ? "workspace-main" : "chat-main";
+  } catch {
+    return "chat-main";
+  }
+}
+
+export function writePanelLayoutPreference(layout: PanelLayout, storage = browserStorage()): void {
+  try {
+    storage?.setItem(storageKey, layout);
+  } catch {
+    // The layout still works for this page when browser storage is unavailable.
+  }
+}
