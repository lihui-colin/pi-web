@@ -0,0 +1,62 @@
+// @vitest-environment happy-dom
+import { afterEach, describe, expect, it } from "vitest";
+import { attachTerminalTouchScroll } from "./terminalTouchScroll";
+
+afterEach(() => { document.body.replaceChildren(); });
+
+function setup() {
+  const host = document.createElement("div");
+  host.innerHTML = '<div class="xterm-screen"><canvas></canvas></div>';
+  document.body.append(host);
+  const target = host.querySelector("canvas");
+  if (target === null) throw new Error("Missing terminal canvas");
+  let tracking = true;
+  const dispose = attachTerminalTouchScroll(host, () => tracking);
+  const wheels: WheelEvent[] = [];
+  host.addEventListener("wheel", (event) => { wheels.push(event); });
+  const touch = (type: string, y: number, count = 1): Event => {
+    const event = new Event(type, { bubbles: true, cancelable: true });
+    Object.defineProperty(event, "touches", { value: Array.from({ length: count }, (_, identifier) => ({ identifier, clientX: 40, clientY: y })) });
+    target.dispatchEvent(event);
+    return event;
+  };
+  return { touch, wheels, dispose, shell: () => { tracking = false; } };
+}
+
+describe("terminal touch scrolling", () => {
+  it("accumulates small drags and sends wheel input in both directions", () => {
+    const { touch, wheels, dispose } = setup();
+    touch("touchstart", 100);
+    touch("touchmove", 91);
+    expect(wheels).toHaveLength(0);
+    expect(touch("touchmove", 60).defaultPrevented).toBe(true);
+    expect(wheels.map((event) => event.deltaY)).toEqual([1, 1]);
+    touch("touchmove", 80);
+    expect(wheels.map((event) => event.deltaY)).toEqual([1, 1, -1]);
+    expect(wheels[0]?.deltaMode).toBe(1);
+    dispose();
+  });
+
+  it("leaves ordinary shell scrollback and taps alone", () => {
+    const { touch, wheels, shell, dispose } = setup();
+    touch("touchstart", 100);
+    touch("touchend", 100, 0);
+    shell();
+    touch("touchstart", 100);
+    expect(touch("touchmove", 40).defaultPrevented).toBe(false);
+    expect(wheels).toHaveLength(0);
+    dispose();
+  });
+
+  it.each(["touchend", "touchcancel", "multitouch", "mode change", "dispose"])("stops translating after %s", (reason) => {
+    const { touch, wheels, shell, dispose } = setup();
+    touch("touchstart", 100);
+    if (reason === "multitouch") touch("touchstart", 100, 2);
+    else if (reason === "mode change") shell();
+    else if (reason === "dispose") dispose();
+    else touch(reason, 100, 0);
+    expect(touch("touchmove", 40).defaultPrevented).toBe(false);
+    expect(wheels).toHaveLength(0);
+    dispose();
+  });
+});
diff --git a/pi-web-plugins/terminal/terminalTouchScroll.ts b/pi-web-plugins/terminal/terminalTouchScroll.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f73f91ed912b97f77128c86484bbd39a35f9bee7
--- /dev/null
+++ b/pi-web-plugins/terminal/terminalTouchScroll.ts
@@ -0,0 +1,48 @@
+/** Translate single-finger drags for mouse-reporting TUIs through xterm's own
+ * wheel handler, so encoding, coordinates and input suppression stay shared.
+ * Ordinary shell scrollback and copy-mode gestures keep their native behavior.
+ */
+export function attachTerminalTouchScroll(host: HTMLElement, mouseTracking: () => boolean): () => void {
+  let gesture: { id: number; y: number; remainder: number; target: Element; x: number; startY: number } | undefined;
+  const reset = (): void => { gesture = undefined; };
+  const start = (event: TouchEvent): void => {
+    reset();
+    const touch = event.touches[0];
+    const target = event.target instanceof Element ? event.target.closest(".xterm-screen") : null;
+    if (event.touches.length !== 1 || touch === undefined || target === null || !mouseTracking()) return;
+    gesture = { id: touch.identifier, y: touch.clientY, remainder: 0, target, x: touch.clientX, startY: touch.clientY };
+  };
+  const move = (event: TouchEvent): void => {
+    const touch = event.touches[0];
+    if (gesture === undefined) return;
+    if (event.touches.length !== 1 || touch?.identifier !== gesture.id || !mouseTracking()) {
+      reset();
+      return;
+    }
+    // A non-passive capture listener prevents native viewport scrolling from
+    // consuming the same drag before xterm receives the translated wheel input.
+    event.preventDefault();
+    event.stopImmediatePropagation();
+    gesture.remainder += gesture.y - touch.clientY;
+    gesture.y = touch.clientY;
+    const threshold = 20;
+    const steps = Math.trunc(gesture.remainder / threshold);
+    gesture.remainder -= steps * threshold;
+    for (let step = 0; step < Math.abs(steps); step += 1) {
+      gesture.target.dispatchEvent(new WheelEvent("wheel", {
+        bubbles: true, cancelable: true, deltaMode: WheelEvent.DOM_DELTA_LINE,
+        deltaY: Math.sign(steps), clientX: gesture.x, clientY: gesture.startY,
+      }));
+    }
+  };
+  const listeners = new AbortController();
+  const options = { capture: true, signal: listeners.signal };
+  host.addEventListener("touchstart", start, { ...options, passive: true });
+  host.addEventListener("touchmove", move, { ...options, passive: false });
+  host.addEventListener("touchend", reset, options);
+  host.addEventListener("touchcancel", reset, options);
+  return () => {
+    reset();
+    listeners.abort();
+  };
+}
