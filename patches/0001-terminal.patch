index 0000000000000000000000000000000000000000..7f43083c774b1e40c1ff41a052eeacd06daa131a
--- /dev/null
+++ b/pi-web-plugins/terminal/server/terminalReplayBuffer.ts
@@ -0,0 +1,133 @@
+const MAX_REPLAY_BUFFER = 200_000;
+const MAX_CSI_LENGTH = 128;
+const ESC = "\u001b";
+const MOUSE_PROTOCOLS = [9, 1000, 1002, 1003];
+const MOUSE_ENCODINGS = [1006, 1016];
+const ALTERNATE_BUFFERS = [47, 1047, 1049];
+const INDEPENDENT_MODES = new Set([1, 6, 7, 12, 25, 45, 66, 1004, 2004, 2026]);
+
+/** Bounded output plus the input/buffer modes at the start of retained output.
+ * TUIs enable mouse reporting once; dropping that setup makes reconnects lose
+ * wheel input even when a resize successfully redraws the screen.
+ */
+export class TerminalReplayBuffer {
+  private buffer = "";
+  private readonly modes = new ReplayModes();
+
+  constructor(private readonly limit = MAX_REPLAY_BUFFER) {
+    if (!Number.isSafeInteger(limit) || limit <= 0) throw new Error("Invalid terminal replay limit");
+  }
+
+  append(data: string): void {
+    this.buffer += data;
+    let cut = Math.max(0, this.buffer.length - this.limit);
+    for (let index = 0; index < cut; index += 1) this.modes.consume(this.buffer.charAt(index));
+    // Never begin a replay halfway through CSI/OSC/DCS or a surrogate pair.
+    // An unfinished discarded control string is completed by later appends.
+    while (cut < this.buffer.length && (!this.modes.atBoundary
+      || (cut > 0 && isHighSurrogate(this.buffer.charCodeAt(cut - 1)) && isLowSurrogate(this.buffer.charCodeAt(cut))))) {
+      this.modes.consume(this.buffer.charAt(cut));
+      cut += 1;
+    }
+    this.buffer = this.buffer.slice(cut);
+  }
+
+  get value(): string {
+    return this.modes.snapshot() + this.buffer;
+  }
+}
+
+/** Only tracks persistent modes, not screen cells or terminal query replies. */
+class ReplayModes {
+  private state: "text" | "escape" | "intermediate" | "csi" | "string" = "text";
+  private osc = false;
+  private csi = "";
+  private csiOverflow = false;
+  private readonly privateModes = new Map<number, boolean>();
+  private insert = false;
+
+  get atBoundary(): boolean { return this.state === "text"; }
+
+  snapshot(): string {
+    return [...this.privateModes].map(([mode, enabled]) => `${ESC}[?${String(mode)}${enabled ? "h" : "l"}`).join("")
+      + (this.insert ? `${ESC}[4h` : "");
+  }
+
+  consume(character: string): void {
+    if (character === "\u0018" || character === "\u001a" || character === "\u009c") {
+      this.state = "text";
+      return;
+    }
+    if (character === ESC) { this.state = "escape"; return; }
+    if (character === "\u009b") { this.startCsi(); return; }
+    if (["\u0090", "\u0098", "\u009d", "\u009e", "\u009f"].includes(character)) {
+      this.state = "string";
+      this.osc = character === "\u009d";
+      return;
+    }
+    if (this.state === "string") {
+      if (this.osc && character === "\u0007") this.state = "text";
+      return;
+    }
+    if (character < " ") return;
+    if (this.state === "escape") {
+      if (character === "[") { this.startCsi(); return; }
+      if (["]", "P", "X", "^", "_"].includes(character)) {
+        this.state = "string";
+        this.osc = character === "]";
+        return;
+      }
+      if (character === "c") { this.privateModes.clear(); this.insert = false; }
+      if (character === "=" || character === ">") this.privateModes.set(66, character === "=");
+      this.state = character >= " " && character <= "/" ? "intermediate" : "text";
+    } else if (this.state === "intermediate") {
+      if (character >= "0" && character <= "~") this.state = "text";
+    } else if (this.state === "csi") {
+      if (character >= "@" && character <= "~") {
+        if (!this.csiOverflow) this.applyCsi(character);
+        this.state = "text";
+      } else if (this.csi.length < MAX_CSI_LENGTH) {
+        this.csi += character;
+      } else {
+        this.csiOverflow = true;
+      }
+    }
+  }
+
+  private startCsi(): void {
+    this.state = "csi";
+    this.csi = "";
+    this.csiOverflow = false;
+  }
+
+  private applyCsi(final: string): void {
+    if (this.csi === "!" && final === "p") {
+      // DECSTR resets core modes but preserves the active buffer and mouse service.
+      for (const mode of INDEPENDENT_MODES) if (mode !== 12) this.privateModes.delete(mode);
+      this.insert = false;
+      return;
+    }
+    if (final !== "h" && final !== "l") return;
+    if (/^\d*(;\d*)*$/u.test(this.csi)) {
+      if (this.csi.split(";").some((parameter) => Number(parameter) === 4)) this.insert = final === "h";
+      return;
+    }
+    if (!/^\?\d*(;\d*)*$/u.test(this.csi)) return;
+    for (const parameter of this.csi.slice(1).split(";")) {
+      const mode = Number(parameter);
+      const enabled = final === "h";
+      const group = [MOUSE_PROTOCOLS, MOUSE_ENCODINGS, ALTERNATE_BUFFERS].find((modes) => modes.includes(mode));
+      if (group !== undefined) {
+        // These modes share one state in Xterm: enabling replaces the previous
+        // mode, and disabling any member resets the entire group.
+        for (const member of group) this.privateModes.delete(member);
+        if (enabled) this.privateModes.set(mode, true);
+      } else if (INDEPENDENT_MODES.has(mode)) {
+        this.privateModes.set(mode, enabled);
+      }
+    }
+  }
+}
+
+function isHighSurrogate(value: number): boolean { return value >= 0xd800 && value <= 0xdbff; }
+function isLowSurrogate(value: number): boolean { return value >= 0xdc00 && value <= 0xdfff; }
