+// @vitest-environment happy-dom
+import { Terminal } from "@xterm/xterm";
+import { afterEach, describe, expect, it } from "vitest";
+import { attachTerminalIosInput } from "./terminalIosInput";
+
+const cleanups: (() => void)[] = [];
+afterEach(() => {
+  for (const cleanup of cleanups.splice(0)) cleanup();
+  document.body.replaceChildren();
+});
+
+function setup(platform = { userAgent: "iPhone", platform: "iPhone", maxTouchPoints: 5 }, patched = true) {
+  const host = document.createElement("div");
+  document.body.append(host);
+  const terminal = new Terminal();
+  terminal.open(host);
+  const textarea = terminal.textarea;
+  if (!textarea) throw new Error("Missing xterm textarea");
+  const dispose = patched ? attachTerminalIosInput(terminal, platform) : () => undefined;
+  cleanups.push(() => { dispose(); terminal.dispose(); });
+  const data: string[] = [];
+  terminal.onData((value) => { data.push(value); });
+  const key = (type: string, keyCode: number, value = "Unidentified") => {
+    textarea.dispatchEvent(new KeyboardEvent(type, { key: value, keyCode, bubbles: true, cancelable: true, composed: true }));
+  };
+  const edit = (inputType: string, value: string | null, cancelable = true) => {
+    const event = new InputEvent("beforeinput", { inputType, data: value, bubbles: true, composed: true, cancelable });
+    textarea.dispatchEvent(event);
+    if (!event.defaultPrevented) {
+      textarea.value += value ?? "";
+      textarea.dispatchEvent(new InputEvent("input", { inputType, data: value, bubbles: true, composed: true }));
+    }
+  };
+  return { terminal, textarea, data, key, edit, dispose };
+}
+
+const tick = () => new Promise<void>((resolve) => { setTimeout(resolve, 10); });
+
+describe("iOS terminal native input", () => {
+  it("reproduces the xterm 6 delayed native edit loss", async () => {
+    const { data, key, edit } = setup(undefined, false);
+    key("keydown", 229);
+    await tick();
+    edit("insertText", "a");
+    key("keyup", 0);
+    await tick();
+    expect(data).toEqual([]);
+  });
+
+  it.each([true, false])("sends delayed native edits once (cancelable=%s)", async (cancelable) => {
+    const { data, key, edit } = setup();
+    for (const text of ["a", " ", "，", "🙂"]) {
+      key("keydown", 229);
+      await tick();
+      edit("insertText", text, cancelable);
+      key("keyup", 0);
+    }
+    await tick();
+    expect(data).toEqual(["a", " ", "，", "🙂"]);
+  });
+
+  it("sends fast consecutive edits once and respects disabled input", async () => {
