+// @vitest-environment happy-dom
+
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { writeClipboardText } from "./clipboard";
+import { writeClipboardText as writeTerminalClipboardText } from "../../../pi-web-plugins/terminal/clipboard";
+
+const originalExecCommand = Object.getOwnPropertyDescriptor(document, "execCommand");
+afterEach(() => {
+  document.body.replaceChildren();
+  if (originalExecCommand) Object.defineProperty(document, "execCommand", originalExecCommand);
+  else Reflect.deleteProperty(document, "execCommand");
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+});
+
+describe.each([["host", writeClipboardText], ["terminal", writeTerminalClipboardText]] as const)("%s clipboard DOM boundary", (_name, writeText) => {
+  it.each([true, false, "throws"])("restores the focused editor through nested shadow roots after fallback copy (%s)", async (result) => {
+    const app = document.createElement("div");
+    const panel = document.createElement("div");
+    const editor = document.createElement("textarea");
+    app.attachShadow({ mode: "open" }).append(panel);
+    const shadow = panel.attachShadow({ mode: "open" });
+    shadow.append(editor);
+    document.body.append(app);
+    editor.value = "unfinished draft";
+    editor.focus();
+    editor.setSelectionRange(3, 8, "backward");
+    vi.stubGlobal("isSecureContext", false);
+    const copy = vi.fn(() => {
+      expect(document.activeElement).toBeInstanceOf(HTMLTextAreaElement);
+      if (result === "throws") throw new Error("Copy denied");
+      return result;
+    });
+    Object.defineProperty(document, "execCommand", { configurable: true, value: copy });
+
+    expect(await writeText("copied output")).toBe(result === true);
+    expect(copy).toHaveBeenCalledExactlyOnceWith("copy");
+    expect(shadow.activeElement).toBe(editor);
+    expect(editor.value).toBe("unfinished draft");
+    expect([editor.selectionStart, editor.selectionEnd, editor.selectionDirection]).toEqual([3, 8, "backward"]);
+    expect(document.body.children).toHaveLength(1);
+  });
+
+  it.each([undefined, null, {}])("uses fallback when the browser exposes an unusable clipboard API (%s)", async (clipboard) => {
+    vi.stubGlobal("isSecureContext", true);
+    vi.stubGlobal("navigator", { clipboard });
+    const copy = vi.fn(() => true);
+    Object.defineProperty(document, "execCommand", { configurable: true, value: copy });
+    expect(await writeText("copied output")).toBe(true);
+    expect(copy).toHaveBeenCalledExactlyOnceWith("copy");
+  });
+});
