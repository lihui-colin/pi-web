diff --git a/pi-web-plugins/terminal/terminalIosInput.ts b/pi-web-plugins/terminal/terminalIosInput.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f56037aec75418d90e6ec820f29bc88a354abc67
--- /dev/null
+++ b/pi-web-plugins/terminal/terminalIosInput.ts
@@ -0,0 +1,77 @@
+import type { Terminal } from "@xterm/xterm";
+
+/** xterm 6 relies on keypress and a keydown-229 timer for text. iOS can
+ * deliver the textarea edit after that timer has run. Use native editing
+ * events for non-composition input; keep xterm's IME and hardware-key handling.
+ */
+export function attachTerminalIosInput(terminal: Terminal, navigator: Pick<Navigator, "userAgent" | "platform" | "maxTouchPoints">): () => void {
+  const ios = /iPad|iPhone|iPod/u.test(navigator.userAgent)
+    || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
+  const textarea = terminal.textarea;
+  const host = textarea?.parentElement;
+  if (!ios || !textarea || !host || terminal.options.screenReaderMode === true) return () => undefined;
+
+  let composing = false;
+  let finishing = false;
+  let keyboardHandled = false;
+  let finishTimer: ReturnType<typeof setTimeout> | undefined;
+  const keySubscription = terminal.onKey(() => { keyboardHandled = true; });
+  const keydown = (event: KeyboardEvent): void => {
+    if (event.target !== textarea) return;
+    keyboardHandled = false;
+    // Do not schedule xterm's textarea-diff timer: it races the native edit
+    // and would duplicate input handled below. Composition still belongs to xterm.
+    // eslint-disable-next-line @typescript-eslint/no-deprecated -- Match xterm 6's legacy IME dispatch boundary.
+    if (!composing && !finishing && event.keyCode === 229) event.stopPropagation();
+  };
+  const keyup = (): void => { keyboardHandled = false; };
+  const compositionStart = (): void => {
+    composing = true;
+    finishing = false;
+    keyboardHandled = false;
+    clearTimeout(finishTimer);
+  };
+  const compositionEnd = (): void => {
+    composing = false;
+    finishing = true;
+    // xterm reads the committed textarea in a timer. Leave the trailing input
+    // event and textarea intact until its composition handler has finished.
+    clearTimeout(finishTimer);
+    finishTimer = setTimeout(() => { finishing = false; }, 0);
+  };
+  const dataFor = (event: InputEvent): string | undefined => {
+    if (event.target !== textarea || composing || finishing || event.isComposing) return undefined;
+    switch (event.inputType) {
+      case "insertText": return event.data ?? undefined;
+      case "insertLineBreak":
+      case "insertParagraph": return "\r";
+      case "deleteContentBackward": return "\x7f";
+      default: return undefined;
+    }
+  };
+  const edit = (event: InputEvent): void => {
+    const data = dataFor(event);
+    const before = event.type === "beforeinput";
+    if (data === undefined || (before && !event.cancelable)) return;
+    // Cancelable beforeinput leaves the helper intact. Otherwise input is the
+    // fallback and must clear it so xterm cannot resend stale text.
+    if (before) event.preventDefault();
+    event.stopPropagation();
+    if (!keyboardHandled) terminal.input(data, true);
+    keyboardHandled = false;
+    if (!before) textarea.value = "";
+  };
+  const listeners = new AbortController();
+  const options = { capture: true, signal: listeners.signal };
+  host.addEventListener("keydown", keydown, options);
+  host.addEventListener("keyup", keyup, options);
+  host.addEventListener("compositionstart", compositionStart, options);
+  host.addEventListener("compositionend", compositionEnd, options);
+  host.addEventListener("beforeinput", edit, options);
+  host.addEventListener("input", edit, options);
+  return () => {
+    clearTimeout(finishTimer);
+    keySubscription.dispose();
+    listeners.abort();
+  };
+}
