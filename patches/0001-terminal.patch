+// @vitest-environment happy-dom
+
+import { Terminal } from "@xterm/xterm";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import * as clipboard from "./clipboard";
+import { TerminalPanel } from "./TerminalPanel";
+import { TerminalClipboardRequests } from "./terminalClipboard";
+
+if (!customElements.get("terminal-clipboard-test")) customElements.define("terminal-clipboard-test", TerminalPanel);
+
+afterEach(() => {
+  document.body.replaceChildren();
+  localStorage.clear();
+  vi.useRealTimers();
+  vi.restoreAllMocks();
+});
+
+async function fixture() {
+  const panel = document.createElement("terminal-clipboard-test");
+  if (!(panel instanceof TerminalPanel)) throw new Error("Expected terminal panel");
+  document.body.append(panel);
+  await panel.updateComplete;
+  const terminal = new Terminal({ cols: 80, rows: 24 });
+  Reflect.set(panel, "visible", true);
+  Reflect.set(panel, "terminal", terminal);
+  Reflect.set(panel, "terminalClipboard", new TerminalClipboardRequests(terminal.parser));
+  Reflect.set(panel, "selectedId", "terminal-1");
+  Reflect.set(panel, "channelGeneration", 1);
+  const write = (data: string, replay = false) => {
+    const handle: unknown = Reflect.get(panel, "handleChannelFrame");
+    if (typeof handle !== "function") throw new Error("Expected terminal frame handler");
+    Reflect.apply(handle, panel, [ 1, { type: "output", data, replay, ...(replay ? { replayComplete: true } : {}) }, "terminal-1", terminal]);
+  };
+  const parsed = async () => {
+    const finished = new Promise<void>((resolve) => { terminal.write("", resolve); });
+    if (vi.isFakeTimers()) await vi.advanceTimersByTimeAsync(0);
+    await finished;
+  };
+  return { panel, terminal, write, parsed };
+}
+
+function osc52(text: string, ending = "\u0007"): string {
+  return `\u001b]52;c;${Buffer.from(text).toString("base64")}${ending}`;
+}
+
+describe("Terminal OSC 52 clipboard", () => {
+  it.each(["\u0007", "\u001b\\"])("copies split UTF-8 output using the browser clipboard (terminator=%j)", async (ending) => {
+    const copy = vi.spyOn(clipboard, "writeClipboardText").mockResolvedValue(true);
+    const { panel, write, parsed } = await fixture();
+    const text = "选中的文本 😀\nsecond line";
+    for (const character of osc52(text, ending)) write(character);
+    await parsed();
+    await panel.updateComplete;
+    expect(copy).toHaveBeenCalledExactlyOnceWith(text);
+    expect(panel.shadowRoot?.querySelector('[role="status"]')?.textContent).toBe("Copied");
+  });
+
+  it("ignores replayed copies even with a live copy already queued for parsing", async () => {
+    const copy = vi.spyOn(clipboard, "writeClipboardText").mockResolvedValue(true);
+    const { write, parsed } = await fixture();
+    write(osc52("old clipboard"), true);
+    write("ordinary live output");
+    write(osc52("new clipboard"));
+    await parsed();
+    expect(copy).toHaveBeenCalledExactlyOnceWith("new clipboard");
+  });
+
+  it("ignores clipboard reads, unsupported targets, empty, invalid and oversized writes", async () => {
+    const copy = vi.spyOn(clipboard, "writeClipboardText").mockResolvedValue(true);
+    const { terminal, write, parsed } = await fixture();
+    const input = vi.fn();
+    terminal.onData(input);
+    for (const data of ["c;?", "p;aGVsbG8=", "c;", "c;!!!", "c;/w==", "c;" + "YQ==".repeat(262_145)]) {
+      write(`\u001b]52;${data}\u0007`);
+    }
+    await parsed();
+    expect(copy).not.toHaveBeenCalled();
+    expect(input).not.toHaveBeenCalled();
+  });
+
+  it.each([false, true])("offers a working explicit copy button after browser failure (throws=%s)", async (throws) => {
+    vi.useFakeTimers();
+    const copy = vi.spyOn(clipboard, "writeClipboardText");
+    if (throws) copy.mockRejectedValueOnce(new Error("NotAllowedError"));
+    else copy.mockResolvedValueOnce(false);
+    copy.mockResolvedValueOnce(true);
+    const { panel, write, parsed } = await fixture();
+    write(osc52("retain for retry"));
+    await parsed();
+    await vi.advanceTimersByTimeAsync(5000);
+    await panel.updateComplete;
+    expect(panel.shadowRoot?.querySelector('[role="status"]')?.textContent).toBe("Automatic copy was blocked.");
+    const retry = [...(panel.shadowRoot?.querySelectorAll("button") ?? [])].find((button) => button.textContent === "Copy to clipboard");
+    expect(retry).toBeDefined();
+    if (retry === undefined) throw new Error("Expected copy retry button");
+    retry.click();
+    await panel.updateComplete;
+    await panel.updateComplete;
+    expect(copy).toHaveBeenNthCalledWith(2, "retain for retry");
+    expect(panel.shadowRoot?.querySelector('[role="status"]')?.textContent).toBe("Copied");
+  });
+
+  it("shows Copied only after success and gives each new copy a full two seconds", async () => {
+    vi.useFakeTimers();
+    let finishFirst!: (value: boolean) => void;
+    let finishSecond!: (value: boolean) => void;
+    vi.spyOn(clipboard, "writeClipboardText")
+      .mockReturnValueOnce(new Promise<boolean>((resolve) => { finishFirst = resolve; }))
+      .mockReturnValueOnce(new Promise<boolean>((resolve) => { finishSecond = resolve; }));
+    const { panel, write, parsed } = await fixture();
+    const status = () => panel.shadowRoot?.querySelector('[role="status"]')?.textContent;
+    write(osc52("first selection"));
+    await parsed();
+    await panel.updateComplete;
+    expect(status()).toBeUndefined();
+
+    finishFirst(true);
+    await vi.advanceTimersByTimeAsync(0);
+    await panel.updateComplete;
+    expect(status()).toBe("Copied");
+    await vi.advanceTimersByTimeAsync(1000);
+
+    write(osc52("second selection"));
+    await parsed();
+    await panel.updateComplete;
+    expect(status()).toBeUndefined();
+    // The previous toast's deadline must not discard a pending copy's result.
+    await vi.advanceTimersByTimeAsync(2000);
+    finishSecond(true);
+    await vi.advanceTimersByTimeAsync(0);
+    await panel.updateComplete;
+    expect(status()).toBe("Copied");
+    await vi.advanceTimersByTimeAsync(1999);
+    await panel.updateComplete;
+    expect(status()).toBe("Copied");
+    await vi.advanceTimersByTimeAsync(1);
+    await panel.updateComplete;
+    expect(status()).toBeUndefined();
+  });
+
+  it("does not copy queued output belonging to a replaced channel", async () => {
+    const copy = vi.spyOn(clipboard, "writeClipboardText").mockResolvedValue(true);
+    const { panel, write, parsed } = await fixture();
+    write(osc52("stale"));
+    Reflect.set(panel, "channelGeneration", 2);
+    await parsed();
+    expect(copy).not.toHaveBeenCalled();
+  });
+
+  it("does not restore a copy notice after its terminal is disposed", async () => {
+    let finish!: (value: boolean) => void;
+    vi.spyOn(clipboard, "writeClipboardText").mockReturnValue(new Promise<boolean>((resolve) => { finish = resolve; }));
+    const { panel, write, parsed } = await fixture();
+    write(osc52("late completion"));
+    await parsed();
+    panel.remove();
+    finish(true);
+    await Promise.resolve();
+    expect(Reflect.get(panel, "clipboardRequest")).toBeUndefined();
+  });
+});
