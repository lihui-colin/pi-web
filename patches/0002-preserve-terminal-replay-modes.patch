index 0000000000000000000000000000000000000000..9284061d1690d05123254ae9a1c5f476347bf4c1
--- /dev/null
+++ b/pi-web-plugins/terminal/server/terminalReplayBuffer.test.ts
@@ -0,0 +1,116 @@
+import { Terminal } from "@xterm/xterm";
+import { afterEach, describe, expect, it } from "vitest";
+import { TerminalReplayBuffer } from "./terminalReplayBuffer";
+
+const ESC = "\u001b";
+const codexModes = `${ESC}[?1049h${ESC}[?1003h${ESC}[?1006h${ESC}[?1004h${ESC}[?2004h`;
+const terminals: Terminal[] = [];
+afterEach(() => { for (const terminal of terminals.splice(0)) terminal.dispose(); });
+
+async function terminalFor(data: string): Promise<Terminal> {
+  const terminal = new Terminal({ allowProposedApi: true, cols: 80, rows: 24 });
+  terminals.push(terminal);
+  await new Promise<void>((resolve) => { terminal.write(data, resolve); });
+  return terminal;
+}
+
+async function expectSameModes(source: string, replay: string): Promise<void> {
+  const [live, restored] = await Promise.all([terminalFor(source), terminalFor(replay)]);
+  expect(restored.modes).toEqual(live.modes);
+  expect(restored.buffer.active.type).toBe(live.buffer.active.type);
+}
+
+describe("terminal replay modes", () => {
+  it("leaves complete, untrimmed output unchanged", () => {
+    const replay = new TerminalReplayBuffer();
+    const source = `${codexModes}hello\r\n`;
+    for (const character of source) replay.append(character);
+    expect(replay.value).toBe(source);
+  });
+
+  it("preserves Codex mouse input and alternate screen after the 200k history limit", async () => {
+    const replay = new TerminalReplayBuffer();
+    const source = codexModes + "x".repeat(210_000);
+    replay.append(source);
+    expect(replay.value.length).toBeLessThan(201_000);
+    expect(replay.value).toContain(`${ESC}[?1006h`);
+    const restored = await terminalFor(replay.value);
+    expect(restored.buffer.active.type).toBe("alternate");
+    expect(restored.modes).toMatchObject({ mouseTrackingMode: "any", bracketedPasteMode: true, sendFocusMode: true });
+    await expectSameModes(source, replay.value);
+  });
+
+  it.each([
+    `${ESC}[?1003;1006;1049;2004h`,
+    `${ESC}[?1003h${ESC}[?1000h`,
+    `${ESC}[?1003h${ESC}[?1000l`,
+    `${ESC}[?1049h${ESC}[?47l`,
+    `${codexModes}${ESC}[?1003;1006;1049;2004l`,
+    `${codexModes}${ESC}c`,
+    `${codexModes}${ESC}[!p`,
+    `${ESC}[?1;6;45h${ESC}[?7l${ESC}[4h${ESC}=`,
+    `${ESC}=${ESC}>${ESC}[?1002h`,
+    `\u009b?1003h\u009b?2004h`,
+  ])("matches Xterm mode transitions after eviction: %j", async (setup) => {
+    const replay = new TerminalReplayBuffer(64);
+    const source = setup + "x".repeat(100);
+    for (const character of source) replay.append(character);
+    await expectSameModes(source, replay.value);
+  });
+
+  it("restores the state at the retained boundary, then replays later mode changes", async () => {
+    const source = codexModes + "x".repeat(100) + `${ESC}[?1003;2004l`;
+    const replay = new TerminalReplayBuffer(64);
+    replay.append(source);
+    expect(replay.value).toContain(`${ESC}[?1003h`);
+    expect(replay.value.endsWith(`${ESC}[?1003;2004l`)).toBe(true);
+    await expectSameModes(source, replay.value);
+  });
+
+  it.each([1, 2, 3, 4, 5, 6, 7, 8])("does not start midway through a mode sequence (cut=%i)", async (cut) => {
+    const source = `${ESC}[?1003h` + "x".repeat(64);
+    const replay = new TerminalReplayBuffer(source.length - cut);
+    replay.append(source);
+    expect(replay.value).not.toMatch(/^(?:\[|\?|1003|003|03|3|h)/u);
+    await expectSameModes(source, replay.value);
+  });
+
+  it("handles discarded sequences completed in a later output chunk", async () => {
+    const replay = new TerminalReplayBuffer(16);
+    replay.append("x".repeat(16) + `${ESC}[?1003`);
+    replay.append("h" + "y".repeat(32));
+    await expectSameModes(`${ESC}[?1003h`, replay.value);
+  });
+
+  it.each([`${ESC}]0;`, `${ESC}Pq`, `${ESC}_`, "\u009d0;"])("skips discarded control-string payloads: %j", async (start) => {
+    const replay = new TerminalReplayBuffer(64);
+    replay.append(codexModes + start + "?1003l".repeat(1000));
+    expect(replay.value.length).toBeLessThan(256);
+    replay.append(`${ESC}\\visible`);
+    expect(replay.value).not.toContain("?1003l");
+    expect(replay.value.endsWith("visible")).toBe(true);
+    await expectSameModes(codexModes, replay.value);
+  });
+
+  it("accepts BEL-terminated OSC and cancelled control strings", async () => {
+    const replay = new TerminalReplayBuffer(32);
+    replay.append(codexModes + `${ESC}]0;` + "x".repeat(100));
+    replay.append(`\u0007${ESC}Pq` + "x".repeat(100));
+    replay.append(`\u0018${ESC}[?1003l`);
+    await expectSameModes(codexModes + `${ESC}[?1003l`, replay.value);
+  });
+
+  it("keeps state storage bounded for unsupported modes and oversized CSI", async () => {
+    const replay = new TerminalReplayBuffer(32);
+    replay.append(codexModes + `${ESC}[?` + "1;".repeat(1000) + "1000h" + "x".repeat(64));
+    for (let mode = 3000; mode < 4000; mode += 1) replay.append(`${ESC}[?${String(mode)}h`);
+    expect(replay.value.length).toBeLessThan(256);
+    await expectSameModes(codexModes, replay.value);
+  });
+
+  it("does not leave half of a Unicode character at the replay boundary", () => {
+    const replay = new TerminalReplayBuffer(5);
+    replay.append("x😀abcd");
+    expect(replay.value).toBe("abcd");
+  });
+});
