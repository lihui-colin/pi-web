index 0000000000000000000000000000000000000000..839cbd4e9d7542a1de627d3e1a334b13e2940573
--- /dev/null
+++ b/pi-web-plugins/terminal/terminalClipboard.ts
@@ -0,0 +1,41 @@
+import type { IDisposable, IParser } from "@xterm/xterm";
+
+/** Collect requests during parsing; the output callback decides whether they are live or replayed. */
+export class TerminalClipboardRequests {
+  private text: string | undefined;
+  private readonly handler: IDisposable;
+
+  constructor(parser: IParser) {
+    this.handler = parser.registerOscHandler(52, (data) => {
+      const text = decodeClipboardRequest(data);
+      if (text !== undefined) this.text = text;
+      return true;
+    });
+  }
+
+  takeText(): string | undefined {
+    const text = this.text;
+    this.text = undefined;
+    return text;
+  }
+
+  dispose(): void {
+    this.handler.dispose();
+    this.text = undefined;
+  }
+}
+
+function decodeClipboardRequest(data: string): string | undefined {
+  const separator = data.indexOf(";");
+  if (separator < 0 || !/^[cs]*$/u.test(data.slice(0, separator))) return undefined;
+  const payload = data.slice(separator + 1);
+  // Only clipboard writes: never answer queries with the user's clipboard contents.
+  // Bound allocation before decoding, and ignore empty requests rather than clearing the clipboard.
+  if (payload === "" || payload === "?" || payload.length > 1_048_576) return undefined;
+  try {
+    const bytes = Uint8Array.from(atob(payload), (character) => character.charCodeAt(0));
+    return new TextDecoder("utf-8", { fatal: true }).decode(bytes);
+  } catch {
+    return undefined;
+  }
+}
