+import type { PiWebPlugin } from "@jmfederico/pi-web/plugin-api";
+import { html, unsafeStatic } from "lit/static-html.js";
+import { CodexPanel } from "./CodexPanel.js";
+import { CodexBrowserRuntime } from "./CodexBrowserRuntime.js";
+
+const plugin: PiWebPlugin = {
+  apiVersion: 4,
+  name: "Codex",
+  activate(context) {
+    const runtime = new CodexBrowserRuntime();
+    const name = `pi-web-codex-${context.runtimePluginId.replaceAll(/[^a-z0-9]+/gu, "-")}`;
+    if (customElements.get(name) === undefined) customElements.define(name, class extends CodexPanel {});
+    const tag = unsafeStatic(name);
+    const dispose = (): void => { runtime.dispose(); };
+    context.lifetimeSignal.addEventListener("abort", dispose, { once: true });
+    return {
+      dispose: () => { context.lifetimeSignal.removeEventListener("abort", dispose); dispose(); },
+      contributions: {
+        workspacePanels: [{
+          id: "workspace.codex", title: "Codex", order: 31,
+          icon: context.svg`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m8 6-6 6 6 6M16 6l6 6-6 6M14 3l-4 18"/></svg>`,
+          badge: (workspace) => runtime.badge(workspace),
+          render: (workspace) => html`<${tag} .context=${workspace} .runtime=${runtime}></${tag}>`,
+        }],
+        actions: [{ id: "view.codex", title: "Go to Codex", group: "Navigation", enabled: (runtimeContext) => runtimeContext.state.selectedWorkspace !== undefined,
+          run: (runtimeContext) => { runtimeContext.selectWorkspaceTool(`${context.runtimePluginId}:workspace.codex`); },
+        }],
+      },
+    };
+  },
+};
+export default plugin;
