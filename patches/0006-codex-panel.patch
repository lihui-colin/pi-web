+// @vitest-environment happy-dom
+import { describe, expect, it } from "vitest";
+import { workspaceFileLink } from "./fileLinks.js";
+import { renderWorkspaceMarkdownHtml, sanitizeWorkspaceMarkdownHtml } from "../files/workspaceMarkdown.js";
+
+describe("Codex workspace file links", () => {
+  it.each([
+    ["/repo/src/app.ts:12", "src/app.ts", 12],
+    ["src/app.ts:12:4", "src/app.ts", 12],
+    ["README.md:3", "README.md", 3],
+    ["Makefile:2", "Makefile", 2],
+    ["./src/../README.md", "README.md", undefined],
+    ["src/app.ts#L12", "src/app.ts", 12],
+    ["src/app.ts#L12C3-L14C8", "src/app.ts", 12],
+    ["file:///repo/docs/My%20File.md#L2", "docs/My File.md", 2],
+    ["/repo/docs/%E8%AF%B4%E6%98%8E.md", "docs/说明.md", undefined],
+    ["notes%23one.txt", "notes#one.txt", undefined],
+  ])("resolves %s within its workspace", (href, path, line) => {
+    expect(workspaceFileLink(href, "/repo/")).toEqual({ path, line });
+  });
+
+  it.each([
+    "", "https://example.com/repo/a.ts:2", "mailto:a@example.com", "javascript:alert(1)",
+    "javascript:1", "data:text/html,test", "vscode://file/repo/a.ts", "//example.com/a.ts",
+    "file://host/repo/a.ts", "../secret.txt", "/repo-other/a.ts", "/repo/../secret.txt",
+    "%2e%2e/secret.txt", "%2f%2fhost/a.ts", "src\\app.ts", "a%00.ts", "bad%ZZ.ts",
+    "#section", "README.md#section", "a.ts?download=1", "a.ts:0", "a.ts:999999999999999999", "/repo",
+  ])("does not turn %s into a workspace read", (href) => {
+    expect(workspaceFileLink(href, "/repo")).toBeUndefined();
+  });
+
+  it("creates file controls only with workspace context and keeps Web links external", () => {
+    const root = document.createElement("div");
+    root.innerHTML = renderWorkspaceMarkdownHtml("[**source**](/repo/a.ts:2) [site](https://example.com) [outside](/other/a.ts)", (href) => workspaceFileLink(href, "/repo"));
+    const button = root.querySelector("button.file-link");
+    expect(button?.getAttribute("data-file-path")).toBe("a.ts");
+    expect(button?.getAttribute("data-file-line")).toBe("2");
+    expect(button?.querySelector("strong")?.textContent).toBe("source");
+    expect(root.querySelector('a[href="https://example.com"]')?.getAttribute("rel")).toBe("noopener noreferrer");
+    expect(root.querySelector('a[href="/other/a.ts"]')).toBeNull();
+    expect(renderWorkspaceMarkdownHtml("[source](/repo/a.ts)")).not.toContain("file-link");
+  });
+
+  it("strips forged controls and active content before exposing local links", () => {
+    const html = sanitizeWorkspaceMarkdownHtml('<a href="/repo/a.ts" data-file-path="../secret" onclick="alert(1)"><strong onclick="alert(1)">source</strong><img src="/tracking"></a><button class="file-link" data-file-path="../secret">forged</button>', (href) => workspaceFileLink(href, "/repo"));
+    expect(html).toContain('data-file-path="a.ts"');
