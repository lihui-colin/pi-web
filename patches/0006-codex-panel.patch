+    if (method === "thread/read") return { thread: { id: "saved", cwd, turns: [{ id: "old", status: "completed", items: [{ id: "answer", type: "agentMessage", text: "Saved answer" }] }] } };
+    if (method === "thread/resume") return { thread: { id: "saved", cwd, turns: [{ id: "old", status: "completed", items: [{ id: "answer", type: "agentMessage", text: "Saved answer" }] }] } };
+    if (method === "turn/start") return { turn: { id: "turn", status: "inProgress" } };
+    return {};
+  });
+  const reply = vi.fn();
+  const reject = vi.fn();
+  const connection: CodexConnection = { request, reply, reject, dispose: vi.fn() };
+  const service = new CodexService((_cwd, event, exited) => { emit = event; exit = exited; return connection; });
+  services.push(service);
+  const call = (operation: string, input: RecordValue = {}, workspace = "/work/one") => service.request({
+    project: { id: "project", name: "Project", path: "/work" }, workspace: { id: workspace, projectId: "project", path: workspace, label: "One", isMain: true },
