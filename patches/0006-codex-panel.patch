--- /dev/null
+++ b/scripts/codex-plugin.artifact.mjs
@@ -0,0 +1,34 @@
+import { readFile } from "node:fs/promises";
+import { resolve } from "node:path";
+import { pathToFileURL } from "node:url";
+import { Window } from "happy-dom";
+import { expect, it } from "vitest";
+
+it("loads the standalone Codex browser bundle and registers disposable machine-scoped panels", async () => {
+  const root = resolve("dist/pi-web-plugins/codex");
+  const metadata = JSON.parse(await readFile(resolve(root, "package.json"), "utf8"));
+  expect(metadata.piWeb.plugins[0]).toMatchObject({ id: "pi-web.codex", machineSpecific: true });
+  const browser = new Window({ url: "http://localhost/" });
+  const names = ["window", "document", "customElements", "HTMLElement", "Document", "CSSStyleSheet", "ShadowRoot", "Node", "localStorage"];
+  const original = new Map(names.map((name) => [name, Object.getOwnPropertyDescriptor(globalThis, name)]));
+  for (const name of names) Object.defineProperty(globalThis, name, { value: name === "window" ? browser : browser[name], configurable: true });
+  const activations = [];
+  try {
+    const { default: plugin } = await import(pathToFileURL(resolve(root, "browser/pi-web-plugin.js")).href);
+    const template = (strings, ...values) => ({ strings, values });
+    for (const machine of ["a", "b"]) {
+      const activation = await plugin.activate({ apiVersion: 4, pluginId: "pi-web.codex", runtimePluginId: `machine.${machine}.pi-web.codex`, html: template, svg: template, lifetimeSignal: new AbortController().signal });
+      activations.push(activation);
+      expect(activation.contributions.workspacePanels[0]).toMatchObject({ id: "workspace.codex", order: 31 });
+      const element = document.createElement(`pi-web-codex-machine-${machine}-pi-web-codex`);
+      document.body.append(element);
+      await element.updateComplete;
+      expect(element.shadowRoot.textContent).toContain("Select a workspace");
+    }
+    expect(customElements.get("pi-web-codex-machine-a-pi-web-codex")).not.toBe(customElements.get("pi-web-codex-machine-b-pi-web-codex"));
+  } finally {
+    for (const activation of activations) activation.dispose();
+    browser.happyDOM.abort();
+    for (const name of names) { const descriptor = original.get(name); if (descriptor === undefined) delete globalThis[name]; else Object.defineProperty(globalThis, name, descriptor); }
+  }
+});
