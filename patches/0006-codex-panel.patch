+import type { PluginPeerChannel, WorkspacePanelContext } from "@jmfederico/pi-web/plugin-api";
+import { MAX_ATTACHMENTS, MAX_ATTACHMENT_BYTES, IMAGE_MIME_TYPES, array, errorText, object, string, text, permissionMode, type PermissionMode, chatMode, type ChatMode, type RecordValue } from "./server/protocol.js";
+
+export interface CodexAttachment {
+  id: string;
+  name: string;
+  kind: "image" | "file";
+  size: number;
+  path: string;
+  preview: string;
+  status: "uploading" | "ready" | "error";
+  progress: number;
+  error: string;
+}
+
+export interface CodexView {
+  context: WorkspacePanelContext;
+  key: string;
+  threadId: string;
+  draft: string;
+  references: string[];
+  attachments: CodexAttachment[];
+  model: string;
+  effort: string;
+  models: RecordValue[];
+  defaultModel: string;
+  defaultEffort: string;
+  threads: RecordValue[];
+  cursor: string;
+  snapshot: RecordValue;
+  error: string;
+  notice: string;
+  connected: boolean;
+  pending: boolean;
+  permissionMode: PermissionMode;
+  mode: ChatMode;
+  modeDirty: boolean;
+  sending: boolean;
+  offset: number;
+  listeners: Set<() => void>;
+  timer: ReturnType<typeof setTimeout> | undefined;
+  polling: boolean;
+  generation: number;
+}
+
+/** Per-machine/workspace state survives panel unmounts, without owning server processes. */
+export class CodexBrowserRuntime {
+  private readonly views = new Map<string, CodexView>();
+  private disposed = false;
+  private readonly attachmentDrafts = new Map<string, CodexAttachment[]>();
+  private readonly uploads = new Map<CodexAttachment, () => void>();
+  private readonly channels = new Map<CodexView, { abort: AbortController; channel?: PluginPeerChannel; retry?: ReturnType<typeof setTimeout> }>();
+  private readonly dirty = new Set<CodexView>();
+  private readonly syncErrors = new Map<CodexView, string>();
+  private readonly memory = new Map<string, string>();
+  view(context: WorkspacePanelContext): CodexView {
+    const key = JSON.stringify([context.machine.id, context.workspace.projectId, context.workspace.id, context.workspace.path]);
+    let view = this.views.get(key);
+    if (view === undefined) {
+      const threadId = "";
+      view = { context, key, threadId, draft: this.read(`${key}:${threadId}:draft`), references: this.readReferences(key, threadId), attachments: [], model: this.read(`${key}:${threadId}:model`), effort: this.read(`${key}:${threadId}:effort`), models: [], defaultModel: "", defaultEffort: "", threads: [], cursor: "", snapshot: {}, error: "", notice: "", connected: false, pending: false, permissionMode: this.readPermissionMode(key), mode: this.readMode(key, threadId), modeDirty: this.read(`${key}:${threadId}:mode`) !== "", sending: false, offset: 0, listeners: new Set(), timer: undefined, polling: false, generation: 0 };
+      view.attachments = this.readAttachments(view, threadId);
+      this.views.set(key, view);
+    }
+    view.context = context;
+    return view;
+  }
+  subscribe(view: CodexView, listener: () => void): () => void {
+    view.listeners.add(listener);
+    if (!view.connected && !view.pending) void this.run(view, () => this.initialize(view));
+    else { this.schedule(view, 0); this.connect(view); }
+    return () => { view.listeners.delete(listener); if (view.listeners.size === 0 && view.snapshot["busy"] !== true) this.disconnect(view); };
+  }
+  badge(context: WorkspacePanelContext): string | number | undefined {
+    const view = this.view(context);
+    const count = array(view.snapshot["approvals"]).length;
+    return count > 0 ? count : view.snapshot["busy"] === true ? "…" : undefined;
+  }
+  async request(view: CodexView, operation: string, input: RecordValue = {}): Promise<RecordValue> {
+    if (this.disposed) throw new Error("Codex plugin is disabled");
+    const peer = view.context.peer;
+    if (peer?.request === undefined) throw new Error("Codex backend unavailable. Restart sessiond after installing the plugin.");
+    return object(await peer.request(operation, input));
+  }
+  async initialize(view: CodexView): Promise<void> {
+    this.disconnect(view); view.generation++;
+    const status = await this.request(view, "status");
+    view.connected = true;
+    view.notice = status["authenticated"] === false && status["requiresOpenaiAuth"] !== false
+      ? "Sign in with `codex login` on this workspace's machine, then reconnect." : "";
+    const models = await this.request(view, "models");
+    view.models = array(models["data"]).map(object);
+    view.defaultModel = text(models["defaultModel"]);
+    view.defaultEffort = text(models["defaultEffort"]);
+    await this.list(view);
+    view.snapshot = {};
+    this.connect(view);
+    await this.refresh(view);
+  }
+  async list(view: CodexView, more = false): Promise<void> {
+    const result = await this.request(view, "list", more && view.cursor !== "" ? { cursor: view.cursor } : {});
+    const entries = array(result["data"]).map(object);
+    view.threads = more ? [...new Map([...view.threads, ...entries].map((entry) => [text(entry["id"]), entry])).values()] : entries;
+    view.cursor = text(result["nextCursor"]);
+    this.changed(view);
+  }
+  async archive(view: CodexView, id: string): Promise<void> {
+    await this.request(view, "archive", { threadId: id });
+    view.threads = view.threads.filter((thread) => text(thread["id"]) !== id);
+    if (view.threadId === id) this.select(view, "");
+    this.changed(view);
+  }
+  select(view: CodexView, id: string): void {
+    this.saveDraft(view, view.draft);
+    this.disconnect(view);
+    view.generation++;
+    view.threadId = id;
+    view.model = this.read(`${view.key}:${id}:model`);
+    view.effort = this.read(`${view.key}:${id}:effort`);
+    view.draft = this.read(`${view.key}:${id}:draft`);
+    view.references = this.readReferences(view.key, id);
+    view.attachments = this.readAttachments(view, id);
+    view.mode = this.readMode(view.key, id);
+    view.modeDirty = this.read(`${view.key}:${id}:mode`) !== "";
+    view.snapshot = {};
+    view.offset = 0;
+    view.error = "";
+    this.syncErrors.delete(view);
+    if (view.notice.startsWith("Live ")) view.notice = "";
+    this.changed(view);
+    this.schedule(view, 0);
+    this.connect(view);
+  }
+  saveModelSettings(view: CodexView, model: string, effort: string): void {
+    view.model = model; view.effort = effort;
+    this.write(`${view.key}:${view.threadId}:model`, model);
+    this.write(`${view.key}:${view.threadId}:effort`, effort);
+    this.changed(view);
+  }
+  private readMode(key: string, threadId: string): ChatMode {
+    try { return chatMode(this.read(`${key}:${threadId}:mode`) || undefined); } catch { return "default"; }
+  }
+  private saveMode(view: CodexView, mode: ChatMode, dirty: boolean): void {
+    view.mode = mode; view.modeDirty = dirty;
+    this.write(`${view.key}:${view.threadId}:mode`, mode);
+    this.changed(view);
+  }
+  setMode(view: CodexView, mode: ChatMode): void {
+    if (view.pending || view.sending || view.snapshot["busy"] === true) return;
+    this.saveMode(view, mode, true);
+  }
+  private readPermissionMode(key: string): PermissionMode {
+    try { return permissionMode(this.read(`${key}:permission-mode`) || undefined); } catch { return "full-access"; }
+  }
+  setPermissionMode(view: CodexView, value: string): void {
+    if (view.pending || view.sending || view.snapshot["busy"] === true) return;
+    view.permissionMode = permissionMode(value);
+    this.write(`${view.key}:permission-mode`, view.permissionMode);
+    this.changed(view);
+  }
+  private permissionInput(view: CodexView): RecordValue {
+    return view.permissionMode === "full-access" ? {} : { permissionMode: view.permissionMode };
+  }
+  saveDraft(view: CodexView, draft: string): void {
+    view.draft = draft;
+    this.write(`${view.key}:${view.threadId}:draft`, draft);
+  }
+  inputHistory(view: CodexView, threadId = view.threadId): string[] {
+    if (threadId === view.threadId && Array.isArray(view.snapshot["inputHistory"])) return array(view.snapshot["inputHistory"]).filter((entry): entry is string => typeof entry === "string" && entry.trim() !== "");
+    try {
+      return array(JSON.parse(this.read(`${view.key}:${threadId}:input-history`) || "[]"))
+        .filter((entry): entry is string => typeof entry === "string" && entry.trim() !== "").slice(-100);
+    } catch { return []; }
+  }
+  saveReferences(view: CodexView, paths: string[]): void {
+    view.references = [...new Set(paths)].slice(0, 20);
+    this.write(`${view.key}:${view.threadId}:references`, JSON.stringify(view.references));
+    this.changed(view);
+  }
+  private readReferences(key: string, threadId: string): string[] {
+    try {
+      return array(JSON.parse(this.read(`${key}:${threadId}:references`) || "[]"))
+        .filter((entry): entry is string => typeof entry === "string" && entry.length <= 4096).slice(0, 20);
+    } catch { return []; }
+  }
+  async create(view: CodexView): Promise<void> {
+    const result = await this.request(view, "create", this.permissionInput(view));
+    this.select(view, text(result["id"]));
+    view.snapshot = { model: text(result["model"]), effort: text(result["effort"]) };
+    await this.list(view);
+  }
+  async fork(view: CodexView, turnId: string): Promise<void> {
+    if (!view.threadId || view.sending || view.snapshot["busy"] === true) return;
+    const generation = view.generation;
+    const model = view.model;
+    const effort = view.effort;
+    const mode = view.mode;
+    const modeDirty = view.modeDirty;
+    const result = await this.request(view, "fork", { threadId: view.threadId, turnId, ...this.permissionInput(view) });
+    const id = string(result["id"], "branched conversation id");
+    if (this.disposed) return;
+    // Persist the new conversation's settings even if navigation changed while
+    // the fork was in flight. Never navigate away from the user's new selection.
+    this.write(`${view.key}:${id}:model`, model);
+    this.write(`${view.key}:${id}:effort`, effort);
+    this.write(`${view.key}:${id}:mode`, mode);
+    if (view.generation !== generation) { await this.list(view); return; }
+    this.select(view, id);
+    this.saveMode(view, mode, modeDirty);
+    view.snapshot = { model: text(result["model"]), effort: text(result["effort"]) };
+    await this.refresh(view);
+    await this.list(view);
+  }
+  private readAttachments(view: CodexView, threadId: string): CodexAttachment[] {
+    const key = `${view.key}:${threadId}:attachments`;
+    const cached = this.attachmentDrafts.get(key);
+    if (cached) return cached;
+    const attachments: CodexAttachment[] = [];
+    const files = view.context.files;
+    try {
+      if (files.capabilityVersion === 1) for (const entry of array(JSON.parse(this.read(key) || this.read(`${view.key}:${threadId}:images`) || "[]")).slice(0, MAX_ATTACHMENTS)) {
+        const attachment = object(entry);
+        const kind = attachment["kind"] === "file" ? "file" : "image";
+        const path = text(attachment["path"]);
+        if (path) attachments.push({ id: text(attachment["id"]), name: text(attachment["name"]), kind, size: typeof attachment["size"] === "number" ? attachment["size"] : 0, path, preview: kind === "image" ? files.previewUrl(path) : "", status: "ready", progress: 100, error: "" });
+      }
+    } catch { /* Invalid saved attachments are discarded, like other optional draft state. */ }
+    this.attachmentDrafts.set(key, attachments);
+    return attachments;
+  }
+  private saveAttachments(view: CodexView, attachments: CodexAttachment[], threadId = view.threadId): void {
+    const key = `${view.key}:${threadId}:attachments`;
+    this.attachmentDrafts.set(key, attachments);
+    this.write(key, JSON.stringify(attachments.filter((attachment) => attachment.status === "ready").map(({ id, name, path, kind, size }) => ({ id, name, path, kind, size }))));
+    if (view.threadId === threadId) view.attachments = attachments;
+    this.changed(view);
+  }
+  async addFiles(view: CodexView, selected: File[]): Promise<void> {
+    if (this.disposed || view.sending) return;
+    const files = view.context.files;
+    if (files.capabilityVersion !== 1) throw new Error("File uploads require an updated workspace host.");
+    if (view.attachments.length + selected.length > MAX_ATTACHMENTS) throw new Error(`Attach at most ${String(MAX_ATTACHMENTS)} files.`);
+    for (const file of selected) {
+      if (file.size > MAX_ATTACHMENT_BYTES) throw new Error("Each file must be at most 20 MiB.");
+      if (isImage(file) && file.size === 0) throw new Error("Images must be nonempty.");
+    }
+    const threadId = view.threadId;
+    const attachments = selected.map((file): CodexAttachment => ({
+      id: Array.from(crypto.getRandomValues(new Uint8Array(16)), (byte) => byte.toString(16).padStart(2, "0")).join(""),
+      name: file.name, kind: isImage(file) ? "image" : "file", size: file.size, path: "", preview: isImage(file) ? URL.createObjectURL(file) : "", status: "uploading", progress: 0, error: "",
+    }));
+    this.saveAttachments(view, [...view.attachments, ...attachments], threadId);
+    await Promise.all(attachments.map(async (attachment, index) => {
+      const file = selected[index];
+      if (!file) return;
+      const blobUrl = attachment.preview;
+      try {
+        const task = files.uploadFile(file, {
+          destinationFolder: [files.defaultUploadFolder, "codex", attachment.id].filter(Boolean).join("/"), overwrite: false, createDirs: true,
+          onProgress: (progress) => { attachment.progress = Math.round(progress.percent * 100); this.changed(view); },
+        });
+        this.uploads.set(attachment, () => { task.cancel(); });
+        const uploaded = await task.completed;
+        attachment.path = uploaded.path; attachment.preview = attachment.kind === "image" ? files.previewUrl(uploaded.path) : ""; attachment.status = "ready"; attachment.progress = 100;
+      } catch (error) {
+        attachment.status = "error"; attachment.error = errorText(error);
+      } finally {
+        this.uploads.delete(attachment);
+        if (attachment.status === "ready" && blobUrl.startsWith("blob:")) URL.revokeObjectURL(blobUrl);
+        if (!this.disposed) this.saveAttachments(view, this.readAttachments(view, threadId), threadId);
+      }
+    }));
+  }
+  removeAttachment(view: CodexView, id: string): void {
+    const attachment = view.attachments.find((entry) => entry.id === id);
+    if (!attachment || view.sending) return;
+    this.uploads.get(attachment)?.();
+    this.uploads.delete(attachment);
+    if (attachment.preview.startsWith("blob:")) URL.revokeObjectURL(attachment.preview);
+    this.saveAttachments(view, view.attachments.filter((entry) => entry !== attachment));
+  }
+  async send(view: CodexView): Promise<void> {
+    if (view.sending) return;
+    if (view.attachments.some((attachment) => attachment.status !== "ready")) throw new Error("Wait for file uploads or remove failed attachments before sending.");
+    const attachments = [...view.attachments];
+    const images = attachments.filter((attachment) => attachment.kind === "image").map((attachment) => attachment.path);
+    const files = attachments.filter((attachment) => attachment.kind === "file").map((attachment) => attachment.path);
+    const draft = view.draft;
+    const references = [...view.references];
+    let threadId = view.threadId;
+    const model = view.model;
+    const effort = view.effort || (model === "" ? "" : text(view.models.find((entry) => text(entry["model"]) === model)?.["defaultReasoningEffort"]));
+    const mode = view.mode;
+    if (!draft.trim() && references.length === 0 && attachments.length === 0) return;
+    view.sending = true; this.changed(view);
+    try {
+      if (threadId === "") {
+        const result = await this.request(view, "create", this.permissionInput(view));
+        threadId = text(result["id"]);
+        if (threadId === "") throw new Error("Codex did not return a conversation ID");
+        const currentDraft = view.draft;
+        this.select(view, threadId);
+        view.snapshot = { model: text(result["model"]), effort: text(result["effort"]) };
+        this.saveDraft(view, currentDraft);
+        this.saveReferences(view, references);
+        this.saveAttachments(view, attachments);
+        this.saveAttachments(view, [], "");
+        this.saveMode(view, mode, true);
+        this.saveModelSettings(view, model, effort);
+        this.write(`${view.key}::model`, "");
+        this.write(`${view.key}::effort`, "");
+        this.write(`${view.key}::draft`, "");
+        this.write(`${view.key}::references`, "[]");
+        this.write(`${view.key}::mode`, "default");
+      }
+      const result = await this.request(view, "send", { threadId, text: draft, mode, ...this.permissionInput(view), ...(images.length > 0 ? { images } : {}), ...(files.length > 0 ? { files } : {}), ...(references.length > 0 ? { references } : {}), ...(model === "" ? {} : { model }), ...(effort === "" ? {} : { effort }) });
+      if (draft.trim() !== "") {
+        const history = this.inputHistory(view, threadId);
+        if (history.at(-1) !== draft) history.push(draft);
+        this.write(`${view.key}:${threadId}:input-history`, JSON.stringify(history.slice(-100)));
+        if (view.threadId === threadId) view.snapshot = { ...view.snapshot, inputHistory: history.slice(-100) };
+      }
+      if (view.threadId === threadId) {
+        this.saveMode(view, result["mode"] === "plan" || result["mode"] === "default" ? result["mode"] : mode, false);
+        this.saveModelSettings(view, model, effort);
+        if (view.draft === draft) this.saveDraft(view, "");
+        this.saveReferences(view, view.references.filter((path) => !references.includes(path)));
+        this.saveAttachments(view, view.attachments.filter((attachment) => !attachments.includes(attachment)));
+        view.snapshot = { ...view.snapshot, ...(result["queued"] === true ? {} : { busy: true, status: "starting" }), version: -1 };
+      }
+    } finally {
+      view.sending = false; this.changed(view);
+    }
+  }
+  async run(view: CodexView, action: () => Promise<unknown>): Promise<void> {
+    if (view.pending || this.disposed) return;
+    view.pending = true;
+    view.error = "";
+    this.changed(view);
+    try { await action(); }
+    catch (error) { view.error = `${errorText(error)} If a send response was lost, check the conversation before sending again.`; }
+    finally { view.pending = false; this.changed(view); this.schedule(view, 0); this.connect(view); }
+  }
+  dispose(): void {
+    this.disposed = true;
+    for (const cancel of this.uploads.values()) cancel();
+    this.uploads.clear();
+    for (const images of this.attachmentDrafts.values()) for (const image of images) if (image.preview.startsWith("blob:")) URL.revokeObjectURL(image.preview);
+    this.attachmentDrafts.clear();
+    for (const view of this.channels.keys()) this.disconnect(view);
+    this.dirty.clear(); this.syncErrors.clear();
+    for (const view of this.views.values()) { if (view.timer !== undefined) clearTimeout(view.timer); view.listeners.clear(); }
+    this.views.clear();
+  }
+  private isDisposed(): boolean { return this.disposed; }
+  async refresh(view: CodexView): Promise<void> {
+    if (this.disposed || !view.connected) return;
+    if (view.polling) { this.dirty.add(view); return; }
+    this.dirty.delete(view);
+    view.polling = true;
+    const generation = view.generation;
+    try {
+      const home = view.threadId === "";
+      const snapshot = await this.request(view, home ? "activity" : "snapshot", home ? {} : { threadId: view.threadId, version: view.snapshot["version"] ?? -1, offset: view.offset });
+      if (generation !== view.generation || this.isDisposed()) return;
+      if (view.error === this.syncErrors.get(view)) { view.error = ""; this.syncErrors.delete(view); this.changed(view); }
+      if (home) {
+        const busyIds = new Set(array(snapshot["busyThreadIds"]).map(text));
+        view.threads = view.threads.map((thread) => ({ ...thread, busy: busyIds.has(text(thread["id"])) }));
+        this.changed(view);
+        return;
+      }
+      if (snapshot["changed"] === true) {
+        view.snapshot = snapshot;
+        if (!view.modeDirty && (snapshot["mode"] === "plan" || snapshot["mode"] === "default")) this.saveMode(view, snapshot["mode"], false);
+        this.changed(view);
+      }
+    } catch (error) {
+      if (generation === view.generation && !this.isDisposed()) { view.error = errorText(error); this.syncErrors.set(view, view.error); this.changed(view); }
+      this.schedule(view, 4000);
+    } finally {
+      view.polling = false;
+      if (this.dirty.delete(view)) this.schedule(view, 0);
+      else if (view.threadId === "") this.schedule(view, 2000);
+      if (view.listeners.size === 0 && view.snapshot["busy"] !== true) this.disconnect(view);
+    }
+  }
+  private schedule(view: CodexView, delay: number): void {
+    if (view.timer !== undefined && delay > 0) return;
+    if (view.timer !== undefined) clearTimeout(view.timer);
+    if (this.disposed || (view.listeners.size === 0 && view.snapshot["busy"] !== true)) return;
+    view.timer = setTimeout(() => { view.timer = undefined; void this.refresh(view); }, delay);
+  }
+  private disconnect(view: CodexView): void {
+    const connection = this.channels.get(view);
+    this.channels.delete(view);
+    if (connection !== undefined) {
+      if (connection.retry !== undefined) clearTimeout(connection.retry);
+      connection.abort.abort(); connection.channel?.close("Codex view detached");
+    }
+    if (view.timer !== undefined) clearTimeout(view.timer);
+    view.timer = undefined;
+  }
+  private connect(view: CodexView): void {
+    const peer = view.context.peer;
+    if (this.disposed || !view.connected || view.threadId === "" || this.channels.has(view) || (view.listeners.size === 0 && view.snapshot["busy"] !== true)) return;
+    if (peer?.openChannel === undefined) {
+      if (view.notice === "") { view.notice = "Live updates unavailable. Update the host or use Reconnect."; this.changed(view); }
+      return;
+    }
+    const connection: { abort: AbortController; channel?: PluginPeerChannel; retry?: ReturnType<typeof setTimeout> } = { abort: new AbortController() };
+    this.channels.set(view, connection);
+    const generation = view.generation;
+    const current = (): boolean => !this.disposed && this.channels.get(view) === connection && view.generation === generation;
+    const retry = (): void => {
+      if (!current()) return;
+      delete connection.channel;
+      view.notice = "Live connection lost. Reconnecting…"; this.changed(view);
+      connection.retry = setTimeout(() => {
+        if (!current()) return;
+        this.disconnect(view); this.connect(view);
+      }, 1500);
+    };
+    void peer.openChannel("events", { threadId: view.threadId }, {
+      signal: connection.abort.signal,
+      onData: (data) => {
+        if (!current()) return;
+        const frame = object(data);
+        if (frame["type"] === "changed" && frame["threadId"] === view.threadId) this.schedule(view, 30);
+      },
+    }).then((channel) => {
+      if (!current()) { channel.close("Stale Codex subscription"); return; }
+      connection.channel = channel;
+      if (view.notice.startsWith("Live ")) view.notice = "";
+      this.changed(view);
+      this.schedule(view, 0);
+      void channel.closed.then(retry, retry);
+    }, retry);
+  }
+  private changed(view: CodexView): void {
+    if (this.disposed) return;
+    for (const listener of view.listeners) listener();
+    view.context.host.requestRender();
+  }
+  private read(key: string): string {
+    const memory = this.memory.get(key);
+    if (memory !== undefined) return memory;
+    try { return localStorage.getItem(`pi-web:codex:${key}`) ?? ""; } catch { return ""; }
+  }
+  private write(key: string, value: string): void {
+    this.memory.set(key, value);
+    try { localStorage.setItem(`pi-web:codex:${key}`, value); } catch { /* Optional browser persistence. */ }
+  }
+}
+
+function isImage(file: File): boolean {
+  return IMAGE_MIME_TYPES.includes(file.type)
+    || ((file.type === "" || file.type === "application/octet-stream") && /\.(?:png|jpe?g|webp|gif)$/iu.test(file.name));
+}
