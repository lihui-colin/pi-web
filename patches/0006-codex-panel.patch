diff --git a/src/client/src/appShell/appShellController.viewport.test.ts b/src/client/src/appShell/appShellController.viewport.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5c1f6e1b6018b9004370bc8f29dec8fbe9587379
--- /dev/null
+++ b/src/client/src/appShell/appShellController.viewport.test.ts
@@ -0,0 +1,82 @@
+// @vitest-environment happy-dom
+
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { AppShellController } from "./appShellController";
+
+class Viewport extends EventTarget {
+  height = 844;
+  offsetTop = 0;
+  scale = 1;
+}
+
+const controllers: AppShellController[] = [];
+afterEach(() => {
+  for (const controller of controllers.splice(0)) controller.hostDisconnected();
+});
+
+function fixture(viewport: Viewport | null = new Viewport()) {
+  const style = document.createElement("div").style;
+  const host = { style, addController: vi.fn(), removeController: vi.fn(), requestUpdate: vi.fn(), updateComplete: Promise.resolve(true) };
+  const controller = new AppShellController(host, { visualViewport: viewport });
+  controllers.push(controller);
+  controller.hostConnected();
+  return { viewport, controller, style };
+}
+
+describe("app shell visual viewport", () => {
+  it("tracks keyboard resize and pan without a layout viewport resize", () => {
+    const viewport = new Viewport();
+    const { style } = fixture(viewport);
+    expect(style.getPropertyValue("--pi-visual-viewport-height")).toBe("844px");
+    viewport.height = 420;
+    viewport.dispatchEvent(new Event("resize"));
+    expect(style.getPropertyValue("--pi-visual-viewport-height")).toBe("420px");
+    viewport.offsetTop = 80;
+    viewport.dispatchEvent(new Event("scroll"));
+    expect(style.getPropertyValue("--pi-visual-viewport-top")).toBe("80px");
+    viewport.height = 844;
+    viewport.offsetTop = 0;
+    viewport.dispatchEvent(new Event("resize"));
+    expect(style.getPropertyValue("--pi-visual-viewport-height")).toBe("844px");
+    expect(style.getPropertyValue("--pi-visual-viewport-top")).toBe("0px");
+  });
+
+  it("keeps native pinch zoom and resumes sizing when zoom returns to normal", () => {
+    const viewport = new Viewport();
+    const { style } = fixture(viewport);
+    viewport.height = 300;
+    viewport.offsetTop = 60;
+    viewport.scale = 2;
+    viewport.dispatchEvent(new Event("resize"));
+    expect(style.getPropertyValue("--pi-visual-viewport-height")).toBe("");
+    expect(style.getPropertyValue("--pi-visual-viewport-top")).toBe("");
+    viewport.scale = 1;
+    viewport.dispatchEvent(new Event("resize"));
+    expect(style.getPropertyValue("--pi-visual-viewport-height")).toBe("300px");
+    expect(style.getPropertyValue("--pi-visual-viewport-top")).toBe("60px");
+  });
+
+  it("uses CSS fallback when the API is unavailable or temporarily reports no height", () => {
+    expect(fixture(null).style.getPropertyValue("--pi-visual-viewport-height")).toBe("");
+    const viewport = new Viewport();
+    const { style } = fixture(viewport);
+    viewport.height = 0;
+    viewport.dispatchEvent(new Event("resize"));
+    expect(style.getPropertyValue("--pi-visual-viewport-height")).toBe("");
+  });
+
+  it("removes viewport listeners and overrides on disconnect, then reads current size on reconnect", () => {
+    const viewport = new Viewport();
+    const { controller, style } = fixture(viewport);
+    controller.hostDisconnected();
+    viewport.height = 420;
+    viewport.offsetTop = 80;
+    viewport.dispatchEvent(new Event("resize"));
+    viewport.dispatchEvent(new Event("scroll"));
+    expect(style.getPropertyValue("--pi-visual-viewport-height")).toBe("");
+    expect(style.getPropertyValue("--pi-visual-viewport-top")).toBe("");
+    controller.hostConnected();
+    expect(style.getPropertyValue("--pi-visual-viewport-height")).toBe("420px");
+    expect(style.getPropertyValue("--pi-visual-viewport-top")).toBe("80px");
+  });
+});
