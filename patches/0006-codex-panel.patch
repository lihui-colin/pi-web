+import { isAbsolute, relative, resolve, sep } from "node:path";
+import { realpath, stat } from "node:fs/promises";
+import type { JsonValue, ServerPluginPeerRequestContext, ServerPluginPeerChannelOpenContext, ServerPluginPeerChannel } from "@jmfederico/pi-web/server-plugin-api";
+import { createCodexConnection, type CodexConnection, type ConnectionFactory } from "./codexProtocol.js";
+import { array, bounded, errorText, object, string, text, type RecordValue } from "./protocol.js";
+
+interface ThreadState {
+  id: string;
+  version: number;
+  model: string;
+  effort: string;
+  turnId: string;
+  status: string;
+  error: string;
+  busy: boolean;
+  items: Map<string, RecordValue>;
+  inputHistory: Map<string, string>;
+  approvals: Map<string, RecordValue>;
+}
+interface WorkspaceState {
+  cwd: string;
+  projectId: string;
+  workspaceId: string;
+  connection: CodexConnection;
+  threads: Map<string, ThreadState>;
+  opening: Map<string, Promise<ThreadState>>;
+  error: string;
+  touched: number;
+}
+const policy = { approvalPolicy: "never", sandbox: "danger-full-access", approvalsReviewer: "user" };
+
+export class CodexService {
+  private readonly workspaces = new Map<string, WorkspaceState>();
+  private readonly sweep: ReturnType<typeof setInterval>;
+  private disposed = false;
+  private checking = false;
+  private historyVersion = -1;
+  private readonly subscriptions = new Set<{ state: WorkspaceState; id: string; notify: () => void; close: () => void }>();
+  async openChannel(context: ServerPluginPeerChannelOpenContext): Promise<ServerPluginPeerChannel> {
+    if (context.operation !== "events") throw new Error("Unsupported Codex channel");
+    context.signal.throwIfAborted();
+    const id = string(object(context.input)["threadId"], "threadId");
+    const state = this.workspace({ ...context, operation: "snapshot" });
+    // Read-only validation: observing external history must not acquire its writer.
+    await this.readSnapshot(state, id);
+    context.signal.throwIfAborted();
+    if (this.disposed) throw new Error("Codex plugin stopped");
+    let finish = (): void => undefined;
+    const closed = new Promise<void>((resolve) => { finish = resolve; });
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    let ended = false;
+    const close = (): void => {
+      if (ended) return;
+      ended = true;
+      if (timer !== undefined) clearTimeout(timer);
+      this.subscriptions.delete(subscription);
+      context.signal.removeEventListener("abort", close);
+      finish();
+    };
+    const notify = (): void => {
+      if (ended || timer !== undefined) return;
+      timer = setTimeout(() => {
+        timer = undefined;
+        try { context.send({ type: "changed", threadId: id }); } catch { close(); }
+      }, 30);
+    };
+    const subscription = { state, id, notify, close };
+    this.subscriptions.add(subscription);
+    context.signal.addEventListener("abort", close, { once: true });
+    notify();
+    return { closed, receive: () => { throw new Error("Codex events channel is read-only"); }, close };
+  }
+  private notify(thread: ThreadState): void {
+    for (const subscription of this.subscriptions) {
+      if (subscription.state.threads.get(subscription.id) === thread) subscription.notify();
+    }
+  }
+  private closeSubscriptions(state?: WorkspaceState): void {
+    for (const subscription of this.subscriptions) {
+      if (state === undefined || subscription.state === state) subscription.close();
+    }
+  }
+  constructor(private readonly connect: ConnectionFactory = createCodexConnection,
+    private readonly resolveWorkspace?: (selection: { projectId: string; workspaceId: string }) => Promise<{ workspace: { path: string } }>) {
+    this.sweep = setInterval(() => {
+      void this.checkWorkspaces();
+      for (const [key, state] of this.workspaces) {
+        if (Date.now() - state.touched > 15 * 60000 && !this.active(state) && state.opening.size === 0) {
+          this.workspaces.delete(key);
+          this.closeSubscriptions(state); state.connection.dispose();
+        }
+      }
+    }, 60000);
+    this.sweep.unref();
+  }
+  dispose(): void {
+    this.disposed = true;
+    this.closeSubscriptions();
+    clearInterval(this.sweep);
+    for (const state of this.workspaces.values()) { this.closeSubscriptions(state); state.connection.dispose(); }
+    this.workspaces.clear();
+  }
+
+  async request(context: ServerPluginPeerRequestContext): Promise<JsonValue> {
+    if (context.signal.aborted || this.disposed) throw new Error("Codex request cancelled");
+    const supported = new Set(["status", "list", "models", "create", "snapshot", "send", "stop", "answer"]);
+    if (!supported.has(context.operation)) throw new Error("Unsupported Codex operation");
+    const input = object(context.input);
+    const state = this.workspace(context);
+    const rpc = (method: string, params: RecordValue) => state.connection.request(method, params);
+    switch (context.operation) {
+      case "status": {
+        const account = await rpc("account/read", { refreshToken: false });
+        return { authenticated: account["account"] !== null, requiresOpenaiAuth: account["requiresOpenaiAuth"] ?? true, policy, cwd: state.cwd };
