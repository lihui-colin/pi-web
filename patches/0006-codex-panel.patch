+import type { PluginCapability, PiWebHostWorkspacesV1, PiWebServerPlugin } from "@jmfederico/pi-web/server-plugin-api";
+import { CodexService } from "./codexService.js";
+
+// Portable capability descriptor: bundled plugin package scopes cannot resolve
+// a runtime self-import of the host npm package. Only its public types are used.
+const workspacesCapability: PluginCapability<PiWebHostWorkspacesV1, 1> = {
+  pluginId: "pi-web.host", id: "workspaces", version: 1,
+  parse(value: unknown): PiWebHostWorkspacesV1 {
+    if (!isWorkspaces(value)) throw new Error("Invalid host workspaces capability");
+    return value;
+  },
+};
+function isWorkspaces(value: unknown): value is PiWebHostWorkspacesV1 {
+  return typeof value === "object" && value !== null && Reflect.get(value, "version") === 1 && typeof Reflect.get(value, "resolve") === "function";
+}
+
+const plugin: PiWebServerPlugin = {
+  apiVersion: 3,
+  name: "Codex",
+  requires: [workspacesCapability],
+  activate(context) {
+    let workspaces: PiWebHostWorkspacesV1 | undefined;
+    const service = new CodexService(undefined, async (selection) => {
+      if (workspaces === undefined) throw new Error("Codex workspace authority unavailable");
+      return workspaces.resolve(selection);
+    });
+    const dispose = (): void => { service.dispose(); };
+    context.lifetimeSignal.addEventListener("abort", dispose, { once: true });
+    return {
+      start: ({ capabilities }) => { workspaces = capabilities.resolve(workspacesCapability); },
+      peer: { request: (request) => service.request(request), openChannel: (request) => service.openChannel(request) },
+      dispose: () => { context.lifetimeSignal.removeEventListener("abort", dispose); dispose(); },
+    };
+  },
+};
+export default plugin;
