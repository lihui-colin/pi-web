+import { afterEach, describe, expect, it, vi } from "vitest";
+import { CodexProcess } from "./codexProtocol.js";
+import type { RecordValue } from "./protocol.js";
+
+const connections: CodexProcess[] = [];
+afterEach(() => { for (const connection of connections) connection.dispose(); connections.length = 0; vi.useRealTimers(); });
+const script = `
+let buffer='';
+process.stdin.on('data',chunk=>{ buffer+=chunk; let end; while((end=buffer.indexOf('\\n'))>=0){const line=buffer.slice(0,end);buffer=buffer.slice(end+1);const msg=JSON.parse(line);if(msg.method==='initialized')continue;
+ if(msg.method==='hang'){continue;}
+ if(msg.method==='crash'){process.exit(3);}
+ if(msg.method==='malformed'){process.stdout.write('not-json\\n');continue;}
+ if(msg.method==='invalid-result'){process.stdout.write(JSON.stringify({id:msg.id,result:null})+'\\n');continue;}
+ const result=msg.method==='initialize'?{}:{message:'你好 😀',pid:process.pid};
+ const data=Buffer.from(JSON.stringify({id:msg.id,result})+'\\n');
+ if(msg.method==='split'){for(let i=0;i<data.length;i++)process.stdout.write(data.subarray(i,i+1));}
+ else process.stdout.write(data);
+}});
+`;
+function fixture() {
+  const events: RecordValue[] = [];
+  const exited = vi.fn();
+  const connection = new CodexProcess(process.cwd(), (frame) => { events.push(frame); }, exited, process.execPath, ["-e", script]);
+  connections.push(connection);
+  return { connection, exited };
+}
+
+describe("Codex stdio transport", () => {
+  it("initializes, correlates parallel requests, and decodes split UTF-8 lines", async () => {
+    const { connection } = fixture();
+    const results = await Promise.all([connection.request("split", {}), connection.request("normal", {})]);
+    expect(results.map((result) => result["message"])).toEqual(["你好 😀", "你好 😀"]);
+  });
+  it("rejects pending requests on process exit and malformed frames", async () => {
+    const first = fixture();
+    await expect(first.connection.request("crash", {})).rejects.toThrow("exited");
+    expect(first.exited).toHaveBeenCalledTimes(1);
+    const second = fixture();
+    await expect(second.connection.request("malformed", {})).rejects.toThrow("protocol error");
+    expect(second.exited).toHaveBeenCalledTimes(1);
+  });
+  it("bounds stalled RPCs and rejects every pending call on timeout", async () => {
+    const { connection } = fixture();
+    await connection.request("normal", {});
+    vi.useFakeTimers();
+    const first = expect(connection.request("hang", {})).rejects.toThrow("timed out");
+    const second = expect(connection.request("hang", {})).rejects.toThrow("timed out");
+    await vi.advanceTimersByTimeAsync(25000);
+    await Promise.all([first, second]);
+    vi.useRealTimers();
+  });
+  it("rejects the malformed response itself as well as other pending requests", async () => {
+    const { connection, exited } = fixture();
+    await connection.request("normal", {});
+    const settled = vi.fn();
+    for (const method of ["hang", "invalid-result"]) {
+      void connection.request(method, {}).then(settled, (error: unknown) => { settled(error); });
+    }
+    await vi.waitFor(() => { expect(settled).toHaveBeenCalledTimes(2); });
+    for (const [error] of settled.mock.calls) {
+      expect(error).toBeInstanceOf(Error);
+      expect(String(error)).toContain("protocol error");
+    }
+    expect(exited).toHaveBeenCalledTimes(1);
+  });
+  it("terminates its actual child on disposal and reports missing executables", async () => {
+    const { connection } = fixture();
+    const result = await connection.request("pid", {});
+    const pid = result["pid"];
+    if (typeof pid !== "number") throw new Error("Expected child pid");
+    connection.dispose();
+    await vi.waitFor(() => { expect(() => process.kill(pid, 0)).toThrow(); });
+    const missing = new CodexProcess(process.cwd(), () => undefined, () => undefined, "/missing/pi-web-codex-executable");
+    connections.push(missing);
+    await expect(missing.request("status", {})).rejects.toThrow("Install Codex CLI");
+  });
+});
diff --git a/pi-web-plugins/codex/server/codexProtocol.ts b/pi-web-plugins/codex/server/codexProtocol.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e315f01fdd441c313abe22ea84610eaae4faa9c8
--- /dev/null
+++ b/pi-web-plugins/codex/server/codexProtocol.ts
@@ -0,0 +1,98 @@
+import { spawn, type ChildProcessWithoutNullStreams } from "node:child_process";
+import { StringDecoder } from "node:string_decoder";
+import { errorText, object, type RecordValue } from "./protocol.js";
+
+export interface CodexConnection {
+  request(method: string, params: RecordValue): Promise<RecordValue>;
+  reply(id: string | number, result: RecordValue): void;
+  reject(id: string | number, message: string): void;
+  dispose(): void;
+}
+export type ConnectionFactory = (cwd: string, event: (frame: RecordValue) => void, exited: (message: string) => void) => CodexConnection;
+
+/** Owns stdio framing and pending RPCs. Never binds process lifetime to an HTTP request. */
+export class CodexProcess implements CodexConnection {
+  private readonly child: ChildProcessWithoutNullStreams;
+  private readonly pending = new Map<number, { resolve: (value: RecordValue) => void; reject: (error: Error) => void; timer: ReturnType<typeof setTimeout> }>();
+  private nextId = 0;
+  private buffer = "";
+  private ended = false;
+  private readonly ready: Promise<void>;
+
+  constructor(cwd: string, private readonly event: (frame: RecordValue) => void, private readonly exited: (message: string) => void,
+    command = "codex", args = ["app-server", "--listen", "stdio://"]) {
+    this.child = spawn(command, args, { cwd, stdio: ["pipe", "pipe", "pipe"], windowsHide: true });
+    const decoder = new StringDecoder("utf8");
+    this.child.stdout.on("data", (chunk: Buffer) => {
+      try {
+        this.buffer += decoder.write(chunk);
+        let newline: number;
+        while ((newline = this.buffer.indexOf("\n")) !== -1) {
+          if (newline > 16 * 1024 * 1024) throw new Error("Codex response exceeds 16 MiB");
+          const line = this.buffer.slice(0, newline);
+          this.buffer = this.buffer.slice(newline + 1);
+          if (line.trim() !== "") this.receive(object(JSON.parse(line)));
+        }
+        if (this.buffer.length > 16 * 1024 * 1024) throw new Error("Codex response exceeds 16 MiB");
+      } catch (error) { this.fail(`Codex protocol error: ${errorText(error)}`); }
+    });
+    // Drain diagnostics without retaining prompts, credentials, or unbounded logs.
+    this.child.stderr.resume();
+    this.child.stdin.on("error", (error) => { this.fail(`Codex stdin: ${error.message}`); });
+    this.child.on("error", (error) => { this.fail(`Cannot start Codex. Install Codex CLI on this machine and check its PATH. ${error.message}`); });
+    this.child.on("exit", (code, signal) => { this.fail(`Codex app-server exited (${String(code ?? signal)}). Reopen the conversation to recover saved history.`); });
+    this.ready = this.rpc("initialize", { clientInfo: { name: "pi_web_codex", title: "PI WEB Codex", version: "1.0.0" }, capabilities: { experimentalApi: true } })
+      .then(() => { this.write({ method: "initialized" }); });
+    void this.ready.catch((error: unknown) => { this.fail(`Codex initialization failed: ${errorText(error)}`); });
+  }
+
+  async request(method: string, params: RecordValue): Promise<RecordValue> {
+    await this.ready;
+    return this.rpc(method, params);
+  }
+  reply(id: string | number, result: RecordValue): void { this.write({ id, result }); }
+  reject(id: string | number, message: string): void { this.write({ id, error: { code: -32601, message } }); }
+  dispose(): void { this.fail("Codex plugin stopped; active work was interrupted."); }
+
+  private rpc(method: string, params: RecordValue): Promise<RecordValue> {
+    if (this.ended) return Promise.reject(new Error("Codex process is unavailable; reconnect to recover."));
+    const id = ++this.nextId;
+    return new Promise((resolve, reject) => {
+      const timer = setTimeout(() => { this.fail(`Codex ${method} timed out; process stopped to avoid an uncertain active turn.`); }, 25000);
+      this.pending.set(id, { resolve, reject, timer });
+      try { this.write({ id, method, params }); }
+      catch (error) { this.fail(errorText(error)); }
+    });
+  }
+  private write(frame: RecordValue): void {
+    if (this.ended) throw new Error("Codex process is closed");
+    if (this.child.stdin.writableLength > 1024 * 1024) throw new Error("Codex input queue is full");
+    this.child.stdin.write(`${JSON.stringify(frame)}\n`);
+  }
+  private receive(frame: RecordValue): void {
+    if (typeof frame["method"] === "string") { this.event(frame); return; }
+    const id = frame["id"];
+    if (typeof id !== "number") return;
+    const pending = this.pending.get(id);
+    if (pending === undefined) return;
+    // Validate before removing the request: protocol failure must reject it too.
+    const response = frame["error"] !== undefined ? new Error(`Codex: ${JSON.stringify(frame["error"])}`) : object(frame["result"]);
+    this.pending.delete(id);
+    clearTimeout(pending.timer);
+    if (response instanceof Error) pending.reject(response);
+    else pending.resolve(response);
+  }
+  private fail(message: string): void {
+    if (this.ended) return;
+    this.ended = true;
+    for (const pending of this.pending.values()) { clearTimeout(pending.timer); pending.reject(new Error(message)); }
+    this.pending.clear();
+    this.child.kill("SIGTERM");
+    const killTimer = setTimeout(() => { if (this.child.exitCode === null) this.child.kill("SIGKILL"); }, 2000);
+    killTimer.unref();
+    this.child.once("exit", () => { clearTimeout(killTimer); });
+    this.exited(message);
+  }
+}
+
+export const createCodexConnection: ConnectionFactory = (cwd, event, exited) => new CodexProcess(cwd, event, exited);
