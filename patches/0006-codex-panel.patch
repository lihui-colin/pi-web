+  const open = (send: ServerPluginPeerChannelOpenContext["send"], signal: AbortSignal, id = "new", workspace = "/work/one") => service.openChannel({
+    project: { id: "project", name: "Project", path: "/work" }, workspace: { id: workspace, projectId: "project", path: workspace, label: "One", isMain: true },
+    operation: "events", input: { threadId: id }, signal, send,
+  });
+  return { call, open, request, connection, reply, reject, emit: (frame: RecordValue) => { emit(frame); }, exit: (message: string) => { exit(message); }, cwd: (value: string) => { cwd = value; } };
+}
+
+const png = Buffer.from("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aL1sAAAAASUVORK5CYII=", "base64");
+
+describe("Codex uploaded image input", () => {
+  it.each(["start", "queue", "steer"])("passes uploaded image bytes by localImage on %s and retains history metadata", async (action) => {
