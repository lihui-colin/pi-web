+});
diff --git a/pi-web-plugins/codex/fileLinks.ts b/pi-web-plugins/codex/fileLinks.ts
new file mode 100644
index 0000000000000000000000000000000000000000..68e333b1a88ef6720ba050819b7a05911df8eeaa
--- /dev/null
+++ b/pi-web-plugins/codex/fileLinks.ts
@@ -0,0 +1,37 @@
+export interface WorkspaceFileLink {
+  readonly path: string;
+  readonly line: number | undefined;
+}
+
+/** Resolve message links within the selected workspace, never against the Web origin. */
+export function workspaceFileLink(href: string, workspacePath: string): WorkspaceFileLink | undefined {
+  let value = href.trim();
+  if (value.startsWith("file:///")) value = value.slice(7);
+  else if (/^(?:https?|mailto|javascript|data|vbscript):/i.test(value)) return undefined;
+  if (value === "" || value.startsWith("#") || value.includes("?")) return undefined;
+  const location = /(?::(\d+)(?::\d+)?|#L(\d+)(?:C\d+)?(?:-L?\d+(?:C\d+)?)?)$/.exec(value);
+  const line = location === null ? undefined : Number(location[1] ?? location[2]);
+  if (line !== undefined && (!Number.isSafeInteger(line) || line < 1)) return undefined;
+  if (location !== null) value = value.slice(0, location.index);
+  if (/^[a-z][a-z\d+.-]*:/i.test(value)) return undefined;
+  if (value.includes("#")) return undefined;
+  try { value = decodeURIComponent(value); } catch { return undefined; }
+  if (value === "" || value.startsWith("//") || value.includes("\\")) return undefined;
+  for (let index = 0; index < value.length; index++) {
+    const code = value.charCodeAt(index);
+    if (code <= 31 || code === 127) return undefined;
+  }
+  if (!workspacePath.startsWith("/")) return undefined;
+  const normalize = (path: string): string[] => {
+    const parts: string[] = [];
+    for (const part of path.split("/")) {
+      if (part === "..") parts.pop();
+      else if (part !== "" && part !== ".") parts.push(part);
+    }
+    return parts;
+  };
+  const root = normalize(workspacePath);
+  const target = normalize(value.startsWith("/") ? value : `${workspacePath}/${value}`);
+  if (target.length <= root.length || root.some((part, index) => target[index] !== part)) return undefined;
+  return { path: target.slice(root.length).join("/"), line };
+}
