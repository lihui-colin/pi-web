+      if (action !== "start") await f.call("send", { threadId: "new", text: "first task" }, cwd);
+      await f.call("send", { threadId: "new", text: action === "steer" ? "Look here" : "", images: ["screenshot.png"] }, cwd);
+      if (action !== "start") {
+        const snapshot = await f.call("snapshot", { threadId: "new" }, cwd);
