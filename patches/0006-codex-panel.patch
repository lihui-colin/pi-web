+// @vitest-environment happy-dom
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { PluginPeerChannelOptions, FileTreeResponse, JsonValue, WorkspacePanelContext } from "@jmfederico/pi-web/plugin-api";
+import { CodexPanel } from "./CodexPanel.js";
+import { CodexBrowserRuntime } from "./CodexBrowserRuntime.js";
+import type { RecordValue } from "./server/protocol.js";
+
+customElements.define("codex-panel-test", CodexPanel);
+const runtimes: CodexBrowserRuntime[] = [];
+afterEach(() => { for (const runtime of runtimes) runtime.dispose(); runtimes.length = 0; document.body.replaceChildren(); localStorage.clear(); vi.useRealTimers(); });
+function context(request: (operation: string, input: JsonValue) => Promise<JsonValue>, machine = "local"): WorkspacePanelContext {
+  return {
+    navigate: () => Promise.resolve(), machine: { id: machine, name: machine, kind: "local" },
+    workspace: { id: "workspace", projectId: "project", path: "/repo", label: "main", isMain: true },
+    files: { readFile: vi.fn(), listFiles: vi.fn(), writeFile: vi.fn(), deleteFile: vi.fn(), moveFile: vi.fn() },
+    peer: { request }, host: { requestRender: vi.fn() }, prompt: { insertText: vi.fn(), getText: () => "", getSelection: () => null }, terminal: { open: vi.fn(), runCommand: vi.fn() },
+  };
+}
+async function fixture() {
+  const request = vi.fn<(operation: string, input: JsonValue) => Promise<JsonValue>>().mockResolvedValue({ changed: false });
+  const runtime = new CodexBrowserRuntime(); runtimes.push(runtime);
+  const scope = context(request);
+  const view = runtime.view(scope); view.connected = true; view.threadId = "thread";
+  const panel = document.createElement("codex-panel-test");
+  if (!(panel instanceof CodexPanel)) throw new Error("Expected Codex panel");
+  panel.context = scope; panel.runtime = runtime;
+  document.body.append(panel); await panel.updateComplete;
+  const textarea = panel.shadowRoot?.querySelector("textarea");
+  if (!(textarea instanceof HTMLTextAreaElement)) throw new Error("Expected message editor");
+  return { request, runtime, view, panel, textarea, scope };
+}
+
+describe("Codex panel", () => {
+  it("shows server settings without making them client overrides and clears choices across threads", async () => {
+    const { request, view, panel, runtime } = await fixture();
+    view.snapshot = { model: "configured-model", effort: "high" };
+    view.models = [{ model: "configured-model", displayName: "Configured model", supportedReasoningEfforts: [{ reasoningEffort: "high" }] }];
+    panel.requestUpdate(); await panel.updateComplete;
+    expect(panel.shadowRoot?.querySelector(".model-picker summary")?.textContent).toContain("Configured model");
+    expect(panel.shadowRoot?.querySelector(".model-picker summary")?.textContent).toContain("high");
+    expect(panel.shadowRoot?.querySelector<HTMLSelectElement>('select[aria-label="Reasoning effort"]')?.disabled).toBe(false);
+    view.draft = "hello";
+    await runtime.send(view);
+    expect(request).toHaveBeenCalledWith("send", { threadId: "thread", text: "hello" });
+    view.model = "manual-model"; view.effort = "low";
+    runtime.select(view, "other"); await panel.updateComplete;
+    expect(view.model).toBe(""); expect(view.effort).toBe("");
+    expect(panel.shadowRoot?.querySelector(".model-picker summary")?.textContent).not.toContain("Configured model");
+  });
+
+  it("does not send during IME composition, sends once on Enter, and clears only acknowledged drafts", async () => {
+    const { request, panel, textarea, view } = await fixture();
+    textarea.value = "你好"; textarea.dispatchEvent(new Event("input"));
+    textarea.dispatchEvent(new CompositionEvent("compositionstart"));
+    textarea.dispatchEvent(new KeyboardEvent("keydown", { key: "Enter", bubbles: true }));
+    expect(request.mock.calls.filter(([operation]) => operation === "send")).toHaveLength(0);
+    textarea.dispatchEvent(new CompositionEvent("compositionend"));
+    textarea.dispatchEvent(new KeyboardEvent("keydown", { key: "Enter", bubbles: true }));
+    textarea.dispatchEvent(new KeyboardEvent("keydown", { key: "Enter", bubbles: true }));
+    await panel.updateComplete; await Promise.resolve(); await panel.updateComplete;
+    expect(request.mock.calls.filter(([operation]) => operation === "send")).toEqual([["send", { threadId: "thread", text: "你好" }]]);
+    expect(view.draft).toBe("");
+  });
+  it("shows a spinner until send acknowledgement then shows stop, and restores send on failure", async () => {
+    const { request, runtime, view, panel } = await fixture();
+    let accept: ((value: JsonValue) => void) | undefined;
+    request.mockImplementation((operation) => operation === "send" ? new Promise<JsonValue>((resolve) => { accept = resolve; }) : Promise.resolve({ changed: false }));
+    runtime.saveDraft(view, "hello"); panel.requestUpdate(); await panel.updateComplete;
+    const button = panel.shadowRoot?.querySelector<HTMLButtonElement>(".primary");
+    if (button === null || button === undefined) throw new Error("Expected composer action");
+    button.click(); await panel.updateComplete;
+    expect(view.sending).toBe(true); expect(button.disabled).toBe(true);
+    expect(button.getAttribute("aria-label")).toBe("Sending message");
+    expect(button.querySelector(".send-spinner")).not.toBeNull();
+    view.snapshot = { busy: true }; panel.requestUpdate(); await panel.updateComplete;
+    expect(button.querySelector(".send-spinner")).not.toBeNull();
+    expect(button.querySelector(".stop-icon")).toBeNull();
+    if (accept === undefined) throw new Error("Expected pending send");
+    accept({ accepted: true });
+    await vi.waitFor(() => { expect(button.disabled).toBe(false); });
+    expect(view.sending).toBe(false); expect(button.querySelector(".send-spinner")).toBeNull();
+    expect(button.getAttribute("aria-label")).toBe("Stop response");
+    view.snapshot = { busy: false }; runtime.saveDraft(view, "retry"); panel.requestUpdate(); await panel.updateComplete;
+    request.mockRejectedValueOnce(new Error("offline")); button.click();
+    await vi.waitFor(() => { expect(view.error).toContain("offline"); expect(button.disabled).toBe(false); });
+    expect(view.draft).toBe("retry"); expect(view.sending).toBe(false);
+    expect(button.getAttribute("aria-label")).toBe("Send message");
+    expect(button.querySelector(".send-spinner")).toBeNull();
+  });
+  it("uses one composer button to send, stop and return to idle", async () => {
+    const { request, panel, textarea, view } = await fixture();
+    const button = panel.shadowRoot?.querySelector<HTMLButtonElement>(".composer-controls>.primary");
+    if (button === null || button === undefined) throw new Error("Expected composer action");
+    expect(button.disabled).toBe(true);
+    textarea.value = "hello"; textarea.dispatchEvent(new Event("input")); await panel.updateComplete;
+    expect(button.disabled).toBe(false); expect(button.getAttribute("aria-label")).toBe("Send message");
+    button.click(); await panel.updateComplete; await Promise.resolve(); await panel.updateComplete;
+    expect(request).toHaveBeenCalledWith("send", { threadId: "thread", text: "hello" });
+    expect(view.draft).toBe(""); await vi.waitFor(() => { expect(button.disabled).toBe(false); });
+    expect(button.getAttribute("aria-label")).toBe("Stop response");
+    expect(panel.shadowRoot?.querySelectorAll(".composer-controls>button")).toHaveLength(1);
+    expect(panel.shadowRoot?.querySelector(".primary")).toBe(button);
+    view.pending = true; panel.requestUpdate(); await panel.updateComplete;
+    expect(button.disabled).toBe(true);
+    view.pending = false; panel.requestUpdate(); await panel.updateComplete;
+    button.click(); button.click(); await panel.updateComplete; await Promise.resolve(); await panel.updateComplete;
+    expect(request.mock.calls.filter(([operation]) => operation === "stop")).toEqual([["stop", { threadId: "thread" }]]);
+    view.snapshot = { busy: false }; panel.requestUpdate(); await panel.updateComplete;
+    expect(button.getAttribute("aria-label")).toBe("Send message"); expect(button.disabled).toBe(true);
+    expect(button.querySelector(".stop-icon")).toBeNull();
+  });
+  it("preserves drafts separately across machine and thread changes and after request failure", async () => {
+    const { request, runtime, view, scope } = await fixture();
+    runtime.saveDraft(view, "draft one");
+    runtime.select(view, "second"); runtime.saveDraft(view, "draft two"); runtime.select(view, "thread");
+    expect(view.draft).toBe("draft one");
+    const remote = runtime.view(context(request, "remote")); expect(remote.draft).toBe("");
+    request.mockRejectedValueOnce(new Error("offline"));
+    await runtime.run(view, () => runtime.send(view));
+    expect(view.draft).toBe("draft one"); expect(view.error).toContain("offline");
+    const recovered = new CodexBrowserRuntime(); runtimes.push(recovered);
+    expect(recovered.view(scope).draft).toBe("draft one");
+  });
+  it("browses sent inputs and restores the unsent draft with arrow keys", async () => {
+    const { runtime, view, textarea, panel } = await fixture();
+    for (const draft of ["first", "second"]) { runtime.saveDraft(view, draft); await runtime.send(view); }
+    textarea.value = "unfinished"; textarea.dispatchEvent(new Event("input"));
+    const arrow = async (key: string) => { textarea.dispatchEvent(new KeyboardEvent("keydown", { key, bubbles: true, cancelable: true })); await panel.updateComplete; };
+    await arrow("ArrowUp"); expect(textarea.value).toBe("second");
+    await arrow("ArrowUp"); expect(textarea.value).toBe("first");
+    await arrow("ArrowUp"); expect(textarea.value).toBe("first");
+    await arrow("ArrowDown"); expect(textarea.value).toBe("second");
+    await arrow("ArrowDown"); expect(textarea.value).toBe("unfinished");
+    runtime.select(view, "other"); await panel.updateComplete;
+    await arrow("ArrowUp"); expect(textarea.value).toBe("");
+  });
+  it("browses Codex history on first open without browser input history", async () => {
+    const { view, panel, textarea, runtime, request } = await fixture();
+    expect(runtime.inputHistory(view)).toEqual([]);
+    request.mockResolvedValueOnce({ changed: true, version: 1, items: [], inputHistory: ["CLI first prompt", "CLI second prompt"] });
+    await runtime.refresh(view); await panel.updateComplete;
+    textarea.dispatchEvent(new KeyboardEvent("keydown", { key: "ArrowUp", bubbles: true }));
+    await panel.updateComplete; expect(textarea.value).toBe("CLI second prompt");
+    textarea.dispatchEvent(new KeyboardEvent("keydown", { key: "ArrowUp", bubbles: true }));
+    await panel.updateComplete; expect(textarea.value).toBe("CLI first prompt");
+  });
+  it("preserves multi-line navigation, selections, modified arrows and IME", async () => {
+    const { runtime, view, textarea } = await fixture();
+    runtime.saveDraft(view, "sent"); await runtime.send(view);
+    textarea.value = "first\nlast"; textarea.dispatchEvent(new Event("input"));
+    for (const [key, start, end, extra] of [
+      ["ArrowUp", 8, 8, {}], ["ArrowDown", 2, 2, {}], ["ArrowUp", 0, 2, {}],
+      ["ArrowUp", 0, 0, { isComposing: true }], ["ArrowUp", 0, 0, { shiftKey: true }],
+      ["ArrowUp", 0, 0, { ctrlKey: true }],
+    ] as const) {
+      textarea.setSelectionRange(start, end);
+      const event = new KeyboardEvent("keydown", { key, ...extra, bubbles: true, cancelable: true });
+      textarea.dispatchEvent(event);
+      expect(event.defaultPrevented).toBe(false); expect(textarea.value).toBe("first\nlast");
+    }
+  });
