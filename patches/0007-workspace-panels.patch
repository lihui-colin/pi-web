diff --git a/pi-web-plugins/files/verticalSplit.test.ts b/pi-web-plugins/files/verticalSplit.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9a51fdb292cbfaa4e6f9064e06beedb29a2e1765
--- /dev/null
+++ b/pi-web-plugins/files/verticalSplit.test.ts
@@ -0,0 +1,77 @@
+// @vitest-environment happy-dom
+import { html, render } from "lit";
+import { afterEach, expect, it, vi } from "vitest";
+import { renderVerticalSplit, verticalSplitRatio, verticalSplitStyle } from "./verticalSplit.js";
+
+afterEach(() => {
+  document.body.replaceChildren();
+  localStorage.clear();
+  vi.restoreAllMocks();
+});
+
+function mount(key = "files") {
+  const container = document.createElement("section");
+  document.body.append(container);
+  render(renderVerticalSplit(html, key, "Resize panels"), container);
+  const handle = container.querySelector<HTMLElement>('[role="separator"]');
+  if (handle === null) throw new Error("Missing separator");
+  return { container, handle };
+}
+
+it("keeps panel preferences separate, clamps keyboard resizing and resets", () => {
+  const { handle } = mount();
+  handle.dispatchEvent(new KeyboardEvent("keydown", { key: "End" }));
+  handle.dispatchEvent(new KeyboardEvent("keydown", { key: "ArrowDown" }));
+  expect(handle.getAttribute("aria-valuenow")).toBe("90");
+  expect(verticalSplitRatio("files")).toBe(90);
+  expect(verticalSplitRatio("git")).toBe(34);
+  expect(mount().handle.getAttribute("aria-valuenow")).toBe("90");
+  handle.dispatchEvent(new MouseEvent("dblclick"));
+  expect(verticalSplitRatio("files")).toBe(34);
+});
+
+it("resizes only the captured pointer and releases it on cancellation", () => {
+  const { container, handle } = mount();
+  vi.spyOn(container, "getBoundingClientRect").mockReturnValue(new DOMRect(0, 100, 400, 402));
+  let captured: number | undefined;
+  handle.setPointerCapture = (id) => { captured = id; };
+  handle.hasPointerCapture = (id) => captured === id;
+  handle.releasePointerCapture = () => { captured = undefined; };
+  handle.dispatchEvent(new PointerEvent("pointerdown", { pointerId: 1, button: 0, isPrimary: true }));
+  handle.dispatchEvent(new PointerEvent("pointermove", { pointerId: 2, clientY: 301 }));
+  expect(verticalSplitRatio("files")).toBe(34);
+  handle.dispatchEvent(new PointerEvent("pointermove", { pointerId: 1, clientY: 301 }));
+  expect(handle.getAttribute("aria-valuenow")).toBe("50");
+  handle.dispatchEvent(new PointerEvent("pointercancel", { pointerId: 1 }));
+  handle.dispatchEvent(new PointerEvent("pointermove", { pointerId: 1, clientY: 500 }));
+  expect(verticalSplitRatio("files")).toBe(50);
+  expect(captured).toBeUndefined();
+});
+
+it("allows keyboard resizing when storage is blocked and ignores corrupt preferences", () => {
+  localStorage.setItem("files", "invalid");
+  expect(verticalSplitStyle("files")).toContain("34fr");
+  vi.spyOn(Storage.prototype, "getItem").mockImplementation(() => { throw new Error("blocked"); });
+  vi.spyOn(Storage.prototype, "setItem").mockImplementation(() => { throw new Error("blocked"); });
+  const { handle } = mount();
+  handle.dispatchEvent(new KeyboardEvent("keydown", { key: "ArrowUp" }));
+  expect(handle.getAttribute("aria-valuenow")).toBe("32");
+});
+
+it.each(["", " ", "NaN", "Infinity"])("ignores invalid saved ratio %j", (value) => {
+  localStorage.setItem("files", value);
+  expect(verticalSplitRatio("files")).toBe(34);
+});
+
+it("consumes resize keys without triggering parent keyboard shortcuts", () => {
+  const { container, handle } = mount();
+  const parentKeydown = vi.fn();
+  container.addEventListener("keydown", parentKeydown);
+  const resize = new KeyboardEvent("keydown", { key: "ArrowDown", bubbles: true, cancelable: true });
+  handle.dispatchEvent(resize);
+  expect(resize.defaultPrevented).toBe(true);
+  expect(parentKeydown).not.toHaveBeenCalled();
+  expect(verticalSplitRatio("files")).toBe(36);
+  handle.dispatchEvent(new KeyboardEvent("keydown", { key: "Tab", bubbles: true }));
+  expect(parentKeydown).toHaveBeenCalledOnce();
+});
