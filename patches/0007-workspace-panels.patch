index 0000000000000000000000000000000000000000..d1b9818e375825847a227b4750d7427d2bd8dddc
--- /dev/null
+++ b/pi-web-plugins/files/verticalSplit.ts
@@ -0,0 +1,74 @@
+import type { HtmlTemplateTag } from "@jmfederico/pi-web/plugin-api";
+
+const minimum = 10;
+const maximum = 90;
+const defaultRatio = 34;
+const handleSize = 8;
+const clampRatio = (ratio: number): number => Math.max(minimum, Math.min(maximum, ratio));
+const splitRows = (ratio: number): string => `minmax(0, ${String(ratio)}fr) ${String(handleSize)}px minmax(0, ${String(100 - ratio)}fr)`;
+
+export function verticalSplitRatio(key: string): number {
+  try {
+    const value = localStorage.getItem(key);
+    const ratio = value === null || value.trim() === "" ? NaN : Number(value);
+    if (Number.isFinite(ratio)) return clampRatio(ratio);
+  } catch { /* Storage is optional in restricted browsers. */ }
+  return defaultRatio;
+}
+
+export function verticalSplitStyle(key: string): string {
+  return `grid-template-rows:${splitRows(verticalSplitRatio(key))}`;
+}
+
+export function renderVerticalSplit(html: HtmlTemplateTag, key: string, label: string) {
+  const update = (handle: HTMLElement, value: number): void => {
+    const ratio = clampRatio(value);
+    const split = handle.parentElement;
+    if (split === null) return;
+    split.style.gridTemplateRows = splitRows(ratio);
+    handle.setAttribute("aria-valuenow", String(Math.round(ratio)));
+    try { localStorage.setItem(key, String(ratio)); } catch { /* Resizing still works without storage. */ }
+  };
+  const move = (event: PointerEvent): void => {
+    const handle = event.currentTarget;
+    if (!(handle instanceof HTMLElement) || !handle.hasPointerCapture(event.pointerId)) return;
+    const bounds = handle.parentElement?.getBoundingClientRect();
+    if (bounds === undefined || bounds.height <= handleSize) return;
+    update(handle, (event.clientY - bounds.top - handleSize / 2) / (bounds.height - handleSize) * 100);
+  };
+  const release = (event: PointerEvent): void => {
+    const handle = event.currentTarget;
+    if (handle instanceof HTMLElement && handle.hasPointerCapture(event.pointerId)) handle.releasePointerCapture(event.pointerId);
+  };
+  return html`<div class="vertical-split-handle" role="separator" tabindex="0"
+    aria-label=${label} aria-orientation="horizontal" aria-valuemin=${minimum} aria-valuemax=${maximum}
+    aria-valuenow=${Math.round(verticalSplitRatio(key))}
+    title="Drag to resize. Double-click to reset."
+    @pointerdown=${(event: PointerEvent) => {
+      if (event.button !== 0 || !event.isPrimary || !(event.currentTarget instanceof HTMLElement)) return;
+      event.preventDefault();
+      event.stopPropagation();
+      event.currentTarget.focus();
+      event.currentTarget.setPointerCapture(event.pointerId);
+    }} @pointermove=${move} @pointerup=${release} @pointercancel=${release}
+    @dblclick=${(event: MouseEvent) => { if (event.currentTarget instanceof HTMLElement) update(event.currentTarget, defaultRatio); }}
+    @keydown=${(event: KeyboardEvent) => {
+      const handle = event.currentTarget;
+      if (!(handle instanceof HTMLElement)) return;
+      const current = Number(handle.getAttribute("aria-valuenow"));
+      const step = event.shiftKey ? 10 : 2;
+      const value = event.key === "ArrowUp" ? current - step : event.key === "ArrowDown" ? current + step
+        : event.key === "Home" ? minimum : event.key === "End" ? maximum : undefined;
+      if (value === undefined) return;
+      event.preventDefault();
+      event.stopPropagation();
+      update(handle, value);
+    }}></div>`;
+}
+
+export const verticalSplitStyles = (scope = "") => `
+  ${scope}.vertical-split-handle { position: relative; box-sizing: border-box; height: ${String(handleSize)}px; min-height: 0; cursor: row-resize; touch-action: none; user-select: none; background: var(--pi-bg); border-block: 1px solid var(--pi-border-muted); }
+  ${scope}.vertical-split-handle::after { content: ""; position: absolute; top: 50%; left: 50%; width: 2px; height: 2px; border-radius: 50%; background: var(--pi-muted); box-shadow: -4px 0 0 var(--pi-muted), 4px 0 0 var(--pi-muted); transform: translate(-50%, -50%); opacity: .55; pointer-events: none; }
+  ${scope}.vertical-split-handle:hover, ${scope}.vertical-split-handle:focus-visible { background: var(--pi-surface-hover); outline: none; }
+  ${scope}.vertical-split-handle:hover::after, ${scope}.vertical-split-handle:focus-visible::after { background: var(--pi-accent); box-shadow: -4px 0 0 var(--pi-accent), 4px 0 0 var(--pi-accent); opacity: 1; }
+`;
