+    }
+  }
+
+  private async ensureCA(): Promise<void> {
+    const caDir = join(this.root, "ca");
+    try {
+      const ca = new X509Certificate(await readFile(join(caDir, "ca.crt")));
+      await readFile(join(caDir, "ca.key"));
