+const execute = promisify(execFile);
+
+export class CertificateError extends Error {
+  constructor(message: string, readonly statusCode: number) { super(message); }
+}
+
+export class CertificateStore {
+  constructor(private readonly root = join(piWebDataDir(), "certificates")) {}
+
+  async status(): Promise<CertificateStatus | null> {
+    try {
+      return parseCertificateStatus(JSON.parse(await readFile(join(this.root, "current.json"), "utf8")));
+    } catch (error) {
+      if (hasCode(error, "ENOENT")) return null;
+      throw error;
+    }
+  }
+
+  async download(kind: "ca" | "server"): Promise<string> {
+    const status = await this.status();
+    if (status === null) throw new CertificateError("尚未生成证书。", 404);
+    return readFile(kind === "ca" ? join(this.root, "ca", "ca.crt") : status.certificatePath, "utf8");
+  }
+
+  async generate(value: unknown): Promise<CertificateStatus> {
+    if (typeof value !== "string" || isIP(value.trim()) === 0 || value.includes("%")) {
+      throw new CertificateError("请输入有效的 IPv4 或 IPv6 地址，不含协议、端口或网卡标识。", 400);
+    }
+    const ip = value.trim();
+    await mkdir(this.root, { recursive: true, mode: 0o700 });
+    await chmod(this.root, 0o700);
+    const lock = join(this.root, ".generate-lock");
+    try { await mkdir(lock, { mode: 0o700 }); } catch (error) {
+      if (hasCode(error, "EEXIST")) throw new CertificateError("证书生成正在进行。若服务曾异常退出，请管理员确认无生成任务后移除 certificates/.generate-lock。", 409);
+      throw error;
+    }
+    let pending: string | undefined;
+    try {
+      await this.ensureCA();
+      pending = await mkdtemp(join(this.root, "server-"));
+      const key = join(pending, "server.key");
+      const cert = join(pending, "server.crt");
+      const csr = join(pending, "server.csr");
+      const extensions = join(pending, "extensions.cnf");
+      await writeFile(extensions, `basicConstraints=critical,CA:FALSE\nkeyUsage=critical,digitalSignature,keyEncipherment\nextendedKeyUsage=serverAuth\nsubjectAltName=IP:${ip}\n`, { mode: 0o600 });
+      await openssl(["req", "-new", "-newkey", "rsa:2048", "-nodes", "-keyout", key, "-out", csr, "-subj", "/CN=PI WEB LAN"]);
+      await chmod(key, 0o600);
+      await openssl(["x509", "-req", "-in", csr, "-CA", join(this.root, "ca", "ca.crt"), "-CAkey", join(this.root, "ca", "ca.key"), "-set_serial", `0x${randomBytes(16).toString("hex")}`, "-out", cert, "-days", "397", "-sha256", "-extfile", extensions]);
+      const certificate = new X509Certificate(await readFile(cert));
+      const ca = new X509Certificate(await readFile(join(this.root, "ca", "ca.crt")));
+      if (certificate.checkIP(ip) === undefined || !certificate.verify(ca.publicKey)) throw new Error("Certificate verification failed");
