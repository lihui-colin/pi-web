+      }
+      return;
+    } catch (error) {
+      if (!hasCode(error, "ENOENT")) throw error;
+      // An existing but incomplete CA must never be silently replaced.
+      try { await mkdir(caDir, { mode: 0o700 }); } catch {
+        throw new CertificateError("内部 CA 文件不完整，请管理员恢复证书及私钥。", 409);
+      }
+    }
+    const temp = await mkdtemp(join(this.root, "ca-pending-"));
+    try {
+      // Use an explicit config: system defaults can duplicate CA extensions.
+      const config = join(temp, "openssl.cnf");
+      await writeFile(config, "[req]\ndistinguished_name=dn\n[dn]\n[ca]\nbasicConstraints=critical,CA:TRUE,pathlen:0\nkeyUsage=critical,keyCertSign,cRLSign\nsubjectKeyIdentifier=hash\nauthorityKeyIdentifier=keyid:always\n", { mode: 0o600 });
+      await openssl(["req", "-config", config, "-extensions", "ca", "-x509", "-newkey", "rsa:2048", "-nodes", "-sha256", "-days", "3650", "-keyout", join(temp, "ca.key"), "-out", join(temp, "ca.crt"), "-subj", "/CN=PI WEB Local CA"]);
+      await chmod(join(temp, "ca.key"), 0o600);
+      await rename(temp, caDir);
+    } catch (error) {
+      await rm(caDir, { recursive: true, force: true });
+      throw error;
+    } finally {
+      await rm(temp, { recursive: true, force: true });
+    }
+  }
+}
+
+async function openssl(args: string[]): Promise<void> {
+  try { await execute("openssl", args, { timeout: 30_000, maxBuffer: 64 * 1024 }); } catch {
+    throw new CertificateError("证书生成失败，请检查服务器已安装 OpenSSL（1.1.1 或更新版本）且证书目录可写。", 500);
+  }
+}
+
+function hasCode(error: unknown, code: string): boolean {
+  return typeof error === "object" && error !== null && "code" in error && error.code === code;
+}
