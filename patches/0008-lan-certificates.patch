+// @vitest-environment happy-dom
+import { afterEach, expect, it, vi } from "vitest";
+import { SettingsCertificatesPanel } from "./SettingsCertificatesPanel";
+
+const certificate = { ip: "192.168.1.42", expiresAt: "2027-10-19T00:00:00Z", caFingerprint: "AA:BB", certificatePath: "/state/certificates/server-1/server.crt", privateKeyPath: "/state/certificates/server-1/server.key" };
+afterEach(() => { document.body.replaceChildren(); vi.unstubAllGlobals(); });
+
+it("loads existing certificates and generates through the form with download links", async () => {
+  const fetchMock = vi.fn<typeof fetch>().mockResolvedValueOnce(new Response("null")).mockResolvedValueOnce(new Response(JSON.stringify(certificate)));
+  vi.stubGlobal("fetch", fetchMock);
+  const panel = new SettingsCertificatesPanel();
+  document.body.append(panel);
+  await vi.waitFor(() => { expect(panel.shadowRoot?.textContent).toContain("尚未生成证书。"); });
+  const input = required(required(panel.shadowRoot).querySelector("input"));
+  input.value = "192.168.1.42";
+  input.dispatchEvent(new Event("input"));
+  required(required(panel.shadowRoot).querySelector("form")).dispatchEvent(new Event("submit", { cancelable: true }));
+  await vi.waitFor(() => { expect(panel.shadowRoot?.querySelectorAll("a").length).toBe(2); });
+  const init = required(fetchMock.mock.calls[1]?.[1]);
+  expect(init.body).toBe(JSON.stringify({ ip: "192.168.1.42" }));
+  expect(new Headers(init.headers).get("X-PI-Web-Certificate")).toBe("1");
+  const links = [...required(panel.shadowRoot).querySelectorAll("a")];
+  expect(links[0]?.href).toContain("/api/certificates/ca.crt");
+  expect(links[1]?.href).toContain("/api/certificates/server.crt");
+  expect(required(panel.shadowRoot).textContent).toContain("生成不会自动启用 HTTPS");
+});
+
+it("shows a failed generation and retains the previous downloadable certificate", async () => {
+  vi.stubGlobal("fetch", vi.fn<typeof fetch>().mockResolvedValueOnce(new Response(JSON.stringify(certificate)))
+    .mockResolvedValueOnce(new Response(JSON.stringify({ error: "OpenSSL 不可用" }), { status: 500 })));
+  const panel = new SettingsCertificatesPanel();
+  document.body.append(panel);
+  await vi.waitFor(() => { expect(panel.shadowRoot?.querySelectorAll("a").length).toBe(2); });
+  required(required(panel.shadowRoot).querySelector("form")).dispatchEvent(new Event("submit", { cancelable: true }));
+  await vi.waitFor(() => { expect(panel.shadowRoot?.querySelector('[role="alert"]')?.textContent).toContain("OpenSSL 不可用"); });
+  expect(required(panel.shadowRoot).querySelectorAll("a")).toHaveLength(2);
+});
+
+function required<T>(value: T | null | undefined): T {
+  if (value === null || value === undefined) throw new Error("Expected rendered control or request");
+  return value;
+}
+
+it("does not repeat a failed initial request when the settings panel reconnects", async () => {
+  const fetchMock = vi.fn<typeof fetch>().mockRejectedValue(new Error("offline"));
+  vi.stubGlobal("fetch", fetchMock);
+  const panel = new SettingsCertificatesPanel();
+  document.body.append(panel);
+  await vi.waitFor(() => { expect(panel.shadowRoot?.querySelector('[role="alert"]')?.textContent).toContain("offline"); });
+  panel.remove();
+  document.body.append(panel);
+  await panel.updateComplete;
+  expect(fetchMock).toHaveBeenCalledTimes(1);
+  required(panel.shadowRoot?.querySelector<HTMLButtonElement>('button[type="button"]')).click();
+  await vi.waitFor(() => { expect(fetchMock).toHaveBeenCalledTimes(2); });
+});
diff --git a/src/client/src/components/settings/SettingsCertificatesPanel.ts b/src/client/src/components/settings/SettingsCertificatesPanel.ts
new file mode 100644
index 0000000000000000000000000000000000000000..819ba4d614a9adb77569b6ab569a0d347647c5e9
--- /dev/null
+++ b/src/client/src/components/settings/SettingsCertificatesPanel.ts
@@ -0,0 +1,121 @@
+import { css, html, LitElement, type TemplateResult } from "lit";
+import { customElement, state } from "lit/decorators.js";
+import type { CertificateStatus } from "../../../../shared/certificates";
+import { certificatesApi } from "../../api/certificates";
+import { resolveAppUrl } from "../../appUrl";
+import { uiButtonStyles } from "../ui/controlStyles";
+import { uiFormStyles } from "../ui/formStyles";
+import { uiSettingsStyles } from "../ui/settingsStyles";
+
+@customElement("settings-certificates-panel")
+export class SettingsCertificatesPanel extends LitElement {
+  @state() private ip = window.location.hostname.replace(/^\[|\]$/g, "");
+  @state() private certificate: CertificateStatus | null = null;
+  @state() private busy = false;
+  @state() private error = "";
+  @state() private loaded = false;
+
+  private initialLoadStarted = false;
+
+  override connectedCallback(): void {
+    super.connectedCallback();
+    // Settings can detach and reattach panels while changing themes or tabs.
+    // Explicit refresh owns subsequent reads, including retries after failures.
+    if (!this.initialLoadStarted) {
+      this.initialLoadStarted = true;
+      void this.load();
+    }
+  }
+
+  private async load(): Promise<void> {
+    if (this.busy) return;
+    this.busy = true;
+    this.error = "";
+    try {
+      this.certificate = await certificatesApi.status();
+      this.loaded = true;
+    } catch (error) {
+      this.error = error instanceof Error ? error.message : String(error);
+    } finally { this.busy = false; }
+  }
+
+  private async generate(event: Event): Promise<void> {
+    event.preventDefault();
+    if (this.busy) return;
+    this.busy = true;
+    this.error = "";
+    try {
+      this.certificate = await certificatesApi.generate(this.ip.trim());
+      this.loaded = true;
+    } catch (error) {
+      this.error = error instanceof Error ? error.message : String(error);
+    } finally { this.busy = false; }
+  }
+
+  override render(): TemplateResult {
+    const certificate = this.certificate;
+    return html`
+      <section class="ui-settings-section" aria-label="内网 HTTPS 证书" aria-busy=${this.busy}>
+        <div class="ui-settings-heading">
+          <h3>内网 HTTPS 证书</h3>
+          <p>为当前网关生成内网 IP 证书。下载 CA 后，需要在每台访问设备上手动安装并信任。</p>
+        </div>
+        <form class="ui-settings-fields" @submit=${(event: Event) => { void this.generate(event); }}>
+          <label class="ui-form-field">
+            <span>访问站点的内网 IP</span>
+            <input class="ui-input" required maxlength="45" .value=${this.ip} ?disabled=${this.busy}
+              placeholder="192.168.1.10" autocomplete="off" spellcheck="false"
+              @input=${(event: Event) => { if (event.target instanceof HTMLInputElement) this.ip = event.target.value; }}>
+            <small>支持 IPv4 / IPv6，不填写 http://、https:// 或端口。建议固定 IP。</small>
+          </label>
+          <div class="ui-settings-actions">
+            <button type="button" class="ui-button" ?disabled=${this.busy} @click=${() => { void this.load(); }}>刷新状态</button>
+            <button class="ui-button ui-button--primary" ?disabled=${this.busy || !this.loaded}>${this.busy ? "处理中…" : certificate === null ? "生成证书" : "重新签发服务器证书"}</button>
+          </div>
+        </form>
+        ${this.error ? html`<p role="alert" class="error">${this.error}</p>` : null}
+        <div role="status">
+          ${!this.loaded ? "正在读取证书状态；读取失败时请刷新重试。" : certificate === null ? "尚未生成证书。" : html`
+            <div class="ui-settings-summary">
+              <strong>已生成（未检测 HTTPS 部署状态）</strong>
+              <span>证书 IP：${certificate.ip}</span>
+              <span>到期时间：${new Date(certificate.expiresAt).toLocaleString()}</span>
+              <span>CA 指纹（SHA-256）：<code>${certificate.caFingerprint}</code></span>
+              <div class="downloads">
+                <a class="ui-button" href=${resolveAppUrl("api/certificates/ca.crt")} download="pi-web-ca.crt">下载 CA 证书（设备安装）</a>
+                <a class="ui-button" href=${resolveAppUrl("api/certificates/server.crt")} download="pi-web-server.crt">下载服务器证书</a>
+              </div>
+              <p>生成不会自动启用 HTTPS。请管理员将以下文件配置到 Nginx，检查配置后重新加载 Nginx。私钥只保存在服务器，不提供下载。</p>
+              <code>ssl_certificate "${certificate.certificatePath}";<br>ssl_certificate_key "${certificate.privateKeyPath}";</code>
+              <small>重新签发保留同一个 CA；已信任该 CA 的设备无需重复安装。旧文件保留，以免影响正在运行的 HTTPS 服务。</small>
+            </div>
+          `}
+        </div>
+        <details>
+          <summary>如何安装和信任 CA 证书</summary>
+          <p>安装前请与管理员核对上方指纹。只能信任自己管理的 CA。</p>
+          <ul>
+            <li>Windows：导入“受信任的根证书颁发机构”。</li>
+            <li>macOS：导入“钥匙串访问”，在证书的信任设置中选择“始终信任”。</li>
+            <li>iPhone / iPad：安装下载的描述文件后，在“设置 → 通用 → 关于本机 → 证书信任设置”中启用完全信任。</li>
+            <li>Android：在系统安全设置中安装“CA 证书”；具体入口和浏览器支持取决于设备。</li>
+          </ul>
+          <p>服务器启用对应证书后，用证书中的 IP 通过 HTTPS 访问。网页无法替你自动安装或设置信任。</p>
+        </details>
+      </section>
+    `;
+  }
+
+  static override styles = [uiButtonStyles, uiFormStyles, uiSettingsStyles, css`
+    :host { display: block; min-width: 0; }
+    p { margin: 0; line-height: 1.5; }
+    code, span { overflow-wrap: anywhere; }
+    code { white-space: pre-wrap; }
+    small, details { color: var(--pi-muted); line-height: 1.5; }
+    details p, details ul { margin-top: 10px; }
+    summary { cursor: pointer; }
+    .downloads { display: flex; flex-wrap: wrap; gap: 8px; }
+    a { color: var(--pi-text); text-decoration: none; }
+    .error { color: var(--pi-danger); }
+  `];
+}
