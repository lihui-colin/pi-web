+export interface CertificateStatus {
+  ip: string;
+  expiresAt: string;
+  caFingerprint: string;
+  certificatePath: string;
+  privateKeyPath: string;
+}
+
+export function parseCertificateStatus(value: unknown): CertificateStatus | null {
+  if (value === null) return null;
+  if (typeof value !== "object" || !("ip" in value) || !("expiresAt" in value) || !("caFingerprint" in value) || !("certificatePath" in value) || !("privateKeyPath" in value)) throw new Error("Invalid certificate response");
+  const { ip, expiresAt, caFingerprint, certificatePath, privateKeyPath } = value;
+  if (typeof ip !== "string" || typeof expiresAt !== "string" || typeof caFingerprint !== "string" || typeof certificatePath !== "string" || typeof privateKeyPath !== "string") throw new Error("Invalid certificate response");
+  return { ip, expiresAt, caFingerprint, certificatePath, privateKeyPath };
+}
