diff --git a/src/server/certificateRoutes.test.ts b/src/server/certificateRoutes.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e3b467b12f70bfefd8744e629d96d1f3e51be1fd
--- /dev/null
+++ b/src/server/certificateRoutes.test.ts
@@ -0,0 +1,83 @@
+import { execFile } from "node:child_process";
+import { X509Certificate } from "node:crypto";
+import { mkdtemp, readFile, rm, stat } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { promisify } from "node:util";
+import Fastify, { type FastifyInstance } from "fastify";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { CertificateStore } from "./certificates.js";
+import { registerCertificateRoutes } from "./certificateRoutes.js";
+import type { CertificateStatus } from "../shared/certificates.js";
+
+const execute = promisify(execFile);
+let root: string;
+let app: FastifyInstance;
+beforeEach(async () => {
+  root = await mkdtemp(join(tmpdir(), "pi-web-certificates-"));
+  app = Fastify();
+  registerCertificateRoutes(app, new CertificateStore(root));
+});
+afterEach(async () => { await app.close(); await rm(root, { recursive: true, force: true }); });
+const headers = { "x-pi-web-certificate": "1", origin: "https://localhost:80" };
+const generate = (ip: string) => app.inject({ method: "POST", url: "/api/certificates", headers, payload: { ip } });
+
+describe("gateway certificates", () => {
+  it("creates a trusted server certificate, exposes only certificates, and preserves the CA across IP changes", async () => {
+    expect((await app.inject("/api/certificates")).json()).toBeNull();
+    expect((await app.inject("/api/certificates/ca.crt")).statusCode).toBe(404);
+    const first = await generate("192.168.1.42");
+    expect(first.statusCode, first.body).toBe(200);
+    const status = first.json<CertificateStatus>();
+    const caDownload = await app.inject("/api/certificates/ca.crt");
+    expect(caDownload.headers["content-disposition"]).toContain("pi-web-ca.crt");
+    expect(caDownload.headers["cache-control"]).toBe("no-store");
+    expect(caDownload.body).not.toContain("PRIVATE KEY");
+    const ca = new X509Certificate(caDownload.body);
+    expect(ca.ca).toBe(true);
+    expect(ca.fingerprint256).toBe(status.caFingerprint);
+    const serverDownload = await app.inject("/api/certificates/server.crt");
+    const cert = new X509Certificate(serverDownload.body);
+    expect(cert.ca).toBe(false);
+    expect(cert.checkIP("192.168.1.42")).toBeDefined();
+    expect(cert.checkIP("192.168.1.43")).toBeUndefined();
+    expect(cert.verify(ca.publicKey)).toBe(true);
+    await execute("openssl", ["verify", "-CAfile", join(root, "ca/ca.crt"), "-purpose", "sslserver", "-verify_ip", "192.168.1.42", status.certificatePath]);
+    expect((await stat(status.privateKeyPath)).mode & 0o777).toBe(0o600);
+    expect((await stat(join(root, "ca/ca.key"))).mode & 0o777).toBe(0o600);
+    expect((await stat(root)).mode & 0o777).toBe(0o700);
+    for (const path of ["ca.key", "server.key", "../ca/ca.key"]) {
+      expect((await app.inject(`/api/certificates/${path}`)).statusCode).toBe(404);
+    }
+    const next = await generate("fd00::42");
+    expect(next.statusCode, next.body).toBe(200);
+    expect(next.json<CertificateStatus>().caFingerprint).toBe(status.caFingerprint);
+    expect((await app.inject("/api/certificates/ca.crt")).body).toBe(caDownload.body);
+    const renewed = new X509Certificate((await app.inject("/api/certificates/server.crt")).body);
+    expect(renewed.checkIP("fd00::42")).toBeDefined();
+    expect(await readFile(status.certificatePath, "utf8")).toBe(serverDownload.body);
+    expect(await new CertificateStore(root).status()).toEqual(next.json());
+  });
+
+  it("rejects invalid IPs and cross-origin or simple browser requests without creating a CA", async () => {
+    for (const ip of ["example.com", "192.168.1.1:443", "127.0.0.1\nDNS:evil.test", "$(touch /tmp/oops)", "fe80::1%eth0"]) {
+      expect((await generate(ip)).statusCode).toBe(400);
+    }
+    for (const requestHeaders of [{}, { ...headers, origin: "https://evil.test" }, { ...headers, origin: "null" }]) {
+      expect((await app.inject({ method: "POST", url: "/api/certificates", headers: requestHeaders, payload: { ip: "192.168.1.42" } })).statusCode).toBe(403);
+    }
+    expect((await app.inject("/api/certificates")).json()).toBeNull();
+    await expect(stat(join(root, "ca"))).rejects.toMatchObject({ code: "ENOENT" });
+  });
+
+  it("serializes competing generation and refuses to replace an incomplete CA", async () => {
+    const results = await Promise.all([generate("192.168.1.1"), generate("192.168.1.2")]);
+    expect(results.map((r) => r.statusCode).sort()).toEqual([200, 409]);
+    const before = (await app.inject("/api/certificates")).body;
+    const ca = (await app.inject("/api/certificates/ca.crt")).body;
+    await rm(join(root, "ca/ca.key"));
+    expect((await generate("192.168.1.3")).statusCode).toBe(409);
+    expect((await app.inject("/api/certificates")).body).toBe(before);
+    expect((await app.inject("/api/certificates/ca.crt")).body).toBe(ca);
+  });
+});
diff --git a/src/server/certificateRoutes.ts b/src/server/certificateRoutes.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b306e658b66a67c5c1c20a1cb0d47ff5f1fe87d6
--- /dev/null
+++ b/src/server/certificateRoutes.ts
@@ -0,0 +1,34 @@
+import type { FastifyInstance } from "fastify";
+import { CertificateError, CertificateStore } from "./certificates.js";
+
+export function registerCertificateRoutes(app: FastifyInstance, store = new CertificateStore()): void {
+  app.register((routes, _options, done) => {
+    routes.addHook("onRequest", async (_request, reply) => {
+      reply.header("Cache-Control", "no-store").header("X-Content-Type-Options", "nosniff");
+    });
+    routes.setErrorHandler((error, _request, reply) => {
+      const status = error instanceof CertificateError ? error.statusCode : 500;
+      return reply.code(status).send({ error: error instanceof CertificateError ? error.message : "无法读取或保存证书，请检查服务器证书目录。" });
+    });
+    routes.get("/api/certificates", () => store.status());
+    routes.post<{ Body: { ip?: unknown } | undefined }>("/api/certificates", { bodyLimit: 1024 }, async (request, reply) => {
+      // The custom header forces a preflight for cross-origin browser requests.
+      // No CORS permission is granted. Host comparison also supports TLS proxies.
+      const origin = request.headers.origin;
+      let sameHost = origin === undefined;
+      try { if (origin !== undefined) sameHost = new URL(origin).host === request.headers.host; } catch { sameHost = false; }
+      if (request.headers["x-pi-web-certificate"] !== "1" || !sameHost) {
+        return reply.code(403).send({ error: "请从本站设置面板生成证书。" });
+      }
+      return store.generate(request.body?.ip);
+    });
+    for (const kind of ["ca", "server"] as const) {
+      routes.get(`/api/certificates/${kind}.crt`, async (_request, reply) => {
+        return reply.type("application/x-x509-ca-cert")
+          .header("Content-Disposition", `attachment; filename="pi-web-${kind}.crt"`)
+          .send(await store.download(kind));
+      });
+    }
+    done();
+  });
+}
