+++ b/pi-web-plugins/files/verticalSplit.test.ts
@@ -0,0 +1,59 @@
+// @vitest-environment happy-dom
+import { html, render } from "lit";
+import { afterEach, expect, it, vi } from "vitest";
+import { renderVerticalSplit, verticalSplitRatio, verticalSplitStyle } from "./verticalSplit.js";
+
+afterEach(() => {
+  document.body.replaceChildren();
+  localStorage.clear();
+  vi.restoreAllMocks();
+});
+
+function mount(key = "files") {
+  const container = document.createElement("section");
+  document.body.append(container);
+  render(renderVerticalSplit(html, key, "Resize panels"), container);
+  const handle = container.querySelector<HTMLElement>('[role="separator"]');
+  if (handle === null) throw new Error("Missing separator");
+  return { container, handle };
+}
+
+it("keeps panel preferences separate, clamps keyboard resizing and resets", () => {
+  const { handle } = mount();
+  handle.dispatchEvent(new KeyboardEvent("keydown", { key: "End" }));
+  handle.dispatchEvent(new KeyboardEvent("keydown", { key: "ArrowDown" }));
+  expect(handle.getAttribute("aria-valuenow")).toBe("90");
+  expect(verticalSplitRatio("files")).toBe(90);
+  expect(verticalSplitRatio("git")).toBe(34);
+  expect(mount().handle.getAttribute("aria-valuenow")).toBe("90");
+  handle.dispatchEvent(new MouseEvent("dblclick"));
+  expect(verticalSplitRatio("files")).toBe(34);
+});
+
+it("resizes only the captured pointer and releases it on cancellation", () => {
+  const { container, handle } = mount();
+  vi.spyOn(container, "getBoundingClientRect").mockReturnValue(new DOMRect(0, 100, 400, 404));
+  let captured: number | undefined;
+  handle.setPointerCapture = (id) => { captured = id; };
+  handle.hasPointerCapture = (id) => captured === id;
+  handle.releasePointerCapture = () => { captured = undefined; };
+  handle.dispatchEvent(new PointerEvent("pointerdown", { pointerId: 1, button: 0, isPrimary: true }));
+  handle.dispatchEvent(new PointerEvent("pointermove", { pointerId: 2, clientY: 302 }));
+  expect(verticalSplitRatio("files")).toBe(34);
+  handle.dispatchEvent(new PointerEvent("pointermove", { pointerId: 1, clientY: 302 }));
+  expect(handle.getAttribute("aria-valuenow")).toBe("50");
+  handle.dispatchEvent(new PointerEvent("pointercancel", { pointerId: 1 }));
+  handle.dispatchEvent(new PointerEvent("pointermove", { pointerId: 1, clientY: 500 }));
+  expect(verticalSplitRatio("files")).toBe(50);
+  expect(captured).toBeUndefined();
+});
+
+it("allows keyboard resizing when storage is blocked and ignores corrupt preferences", () => {
+  localStorage.setItem("files", "invalid");
+  expect(verticalSplitStyle("files")).toContain("34fr");
+  vi.spyOn(Storage.prototype, "getItem").mockImplementation(() => { throw new Error("blocked"); });
+  vi.spyOn(Storage.prototype, "setItem").mockImplementation(() => { throw new Error("blocked"); });
+  const { handle } = mount();
+  handle.dispatchEvent(new KeyboardEvent("keydown", { key: "ArrowUp" }));
+  expect(handle.getAttribute("aria-valuenow")).toBe("32");
+});
diff --git a/pi-web-plugins/files/verticalSplit.ts b/pi-web-plugins/files/verticalSplit.ts
new file mode 100644
index 0000000000000000000000000000000000000000..41721c3d1596e165e9aaa868f6239dc220fcf288
--- /dev/null
+++ b/pi-web-plugins/files/verticalSplit.ts
@@ -0,0 +1,67 @@
+import type { HtmlTemplateTag } from "@jmfederico/pi-web/plugin-api";
+
+const minimum = 10;
+const maximum = 90;
+
+export function verticalSplitRatio(key: string, fallback = 34): number {
+  try {
+    const value = localStorage.getItem(key);
+    const ratio = value === null ? NaN : Number(value);
+    if (Number.isFinite(ratio)) return Math.max(minimum, Math.min(maximum, ratio));
+  } catch { /* Storage is optional in restricted browsers. */ }
+  return fallback;
+}
+
+export function verticalSplitStyle(key: string, fallback = 34): string {
+  const ratio = verticalSplitRatio(key, fallback);
+  return `grid-template-rows:minmax(0, ${String(ratio)}fr) 4px minmax(0, ${String(100 - ratio)}fr)`;
+}
+
+export function renderVerticalSplit(html: HtmlTemplateTag, key: string, label: string, fallback = 34) {
+  const update = (handle: HTMLElement, value: number): void => {
+    const ratio = Math.max(minimum, Math.min(maximum, value));
+    const split = handle.parentElement;
+    if (split === null) return;
+    split.style.gridTemplateRows = `minmax(0, ${String(ratio)}fr) 4px minmax(0, ${String(100 - ratio)}fr)`;
+    handle.setAttribute("aria-valuenow", String(Math.round(ratio)));
+    try { localStorage.setItem(key, String(ratio)); } catch { /* Resizing still works without storage. */ }
+  };
+  const move = (event: PointerEvent): void => {
+    const handle = event.currentTarget;
+    if (!(handle instanceof HTMLElement) || !handle.hasPointerCapture(event.pointerId)) return;
+    const bounds = handle.parentElement?.getBoundingClientRect();
+    if (bounds === undefined || bounds.height <= 4) return;
+    update(handle, (event.clientY - bounds.top - 2) / (bounds.height - 4) * 100);
+  };
+  const release = (event: PointerEvent): void => {
+    const handle = event.currentTarget;
+    if (handle instanceof HTMLElement && handle.hasPointerCapture(event.pointerId)) handle.releasePointerCapture(event.pointerId);
+  };
+  return html`<div class="vertical-split-handle" role="separator" tabindex="0"
+    aria-label=${label} aria-orientation="horizontal" aria-valuemin=${minimum} aria-valuemax=${maximum}
+    aria-valuenow=${Math.round(verticalSplitRatio(key, fallback))}
+    title="Drag to resize. Double-click to reset."
+    @pointerdown=${(event: PointerEvent) => {
+      if (event.button !== 0 || !event.isPrimary || !(event.currentTarget instanceof HTMLElement)) return;
+      event.preventDefault();
+      event.currentTarget.focus();
+      event.currentTarget.setPointerCapture(event.pointerId);
+    }} @pointermove=${move} @pointerup=${release} @pointercancel=${release}
+    @dblclick=${(event: MouseEvent) => { if (event.currentTarget instanceof HTMLElement) update(event.currentTarget, fallback); }}
+    @keydown=${(event: KeyboardEvent) => {
+      const handle = event.currentTarget;
+      if (!(handle instanceof HTMLElement)) return;
+      const current = Number(handle.getAttribute("aria-valuenow"));
+      const step = event.shiftKey ? 10 : 2;
+      const value = event.key === "ArrowUp" ? current - step : event.key === "ArrowDown" ? current + step
+        : event.key === "Home" ? minimum : event.key === "End" ? maximum : undefined;
+      if (value === undefined) return;
+      event.preventDefault();
+      update(handle, value);
+    }}></div>`;
+}
+
+export const verticalSplitStyles = (scope = "") => `
+  ${scope}.vertical-split-handle { min-height: 0; cursor: row-resize; touch-action: none; user-select: none; background: var(--pi-border-muted); }
+  ${scope}.vertical-split-handle:hover, ${scope}.vertical-split-handle:focus-visible { background: var(--pi-accent); outline: none; }
+`;
