+  it("keeps New chat beside the directory and collapses mobile header actions", async () => {
+    const { panel, textarea } = await fixture();
+    let width = 390;
+    vi.spyOn(panel, "getBoundingClientRect").mockImplementation(() => new DOMRect(0, 0, width, 700));
+    panel.requestUpdate(); await panel.updateComplete;
+    const root = panel.shadowRoot;
+    const menu = root?.querySelector<HTMLDetailsElement>("header .header-actions");
+    const review = menu?.querySelector<HTMLButtonElement>(".review-toggle");
+    if (!root || !menu || !review) throw new Error("Expected collapsed header actions");
+    expect(menu.open).toBe(false);
+    expect(root.querySelector("header > .scope + .new-chat")).not.toBeNull();
+    expect(menu.querySelector(".reconnect")).not.toBeNull();
+    menu.open = true;
+    review.click(); await panel.updateComplete;
+    expect(menu.open).toBe(false);
+    expect(root.querySelector("aside")).not.toBeNull();
+    menu.open = true;
+    textarea.dispatchEvent(new Event("pointerdown", { bubbles: true, composed: true }));
+    expect(menu.open).toBe(false);
+    menu.open = true;
+    menu.dispatchEvent(new KeyboardEvent("keydown", { key: "Escape", bubbles: true, composed: true }));
+    expect(menu.open).toBe(false);
+    expect(root.activeElement).toBe(menu.querySelector("summary"));
+    width = 900; panel.requestUpdate(); await panel.updateComplete;
+    expect(root.querySelector(".header-actions")).toBeNull();
+    expect(root.querySelector("header > .review-toggle")).not.toBeNull();
+    expect(root.querySelector("header > .reconnect")).not.toBeNull();
+  });
