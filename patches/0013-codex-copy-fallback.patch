 }
 
 describe("Codex panel", () => {
+  it.each(["available", "missing", "denied", "blocked"])("copies messages and code with clipboard %s even during session work", async (clipboardState) => {
+    const { panel, view } = await fixture();
+    const writeText = vi.fn().mockImplementation(() => clipboardState === "denied" || clipboardState === "blocked" ? Promise.reject(new Error("Denied")) : Promise.resolve());
+    vi.stubGlobal("navigator", clipboardState === "missing" ? {} : { clipboard: { writeText } });
+    vi.stubGlobal("isSecureContext", clipboardState !== "missing");
+    const original = Object.getOwnPropertyDescriptor(document, "execCommand");
+    const fallback = vi.fn(() => clipboardState !== "blocked");
+    Object.defineProperty(document, "execCommand", { configurable: true, value: fallback });
+    try {
+      const body = "Answer\n\n```text\nexample\n```";
+      view.snapshot = { items: [{ id: "answer", kind: "agentMessage", text: body }] };
+      view.pending = true;
+      panel.requestUpdate(); await panel.updateComplete;
+      for (const [label, expected] of [["Copy message or tool output", body], ["Copy code block", "example\n"]]) {
+        const button = panel.shadowRoot?.querySelector<HTMLButtonElement>(`button[aria-label="${label}"]`);
+        if (!button) throw new Error("Missing copy button");
+        button.click();
+        await vi.waitFor(() => expect(button.textContent).toBe(clipboardState === "blocked" ? "Copy failed — retry" : "Copied"));
+        expect(button.disabled).toBe(false);
+        if (clipboardState === "available") expect(writeText).toHaveBeenLastCalledWith(expected);
+        else expect(fallback).toHaveBeenLastCalledWith("copy");
+      }
+      expect(view.pending).toBe(true);
+      expect(document.body.querySelector("textarea")).toBeNull();
+    } finally {
+      if (original) Object.defineProperty(document, "execCommand", original);
+      else Reflect.deleteProperty(document, "execCommand");
+    }
+  });
   it("puts mobile model and permission settings in Add and restores desktop controls on resize", async () => {
