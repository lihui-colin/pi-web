# 复制为 data/pi-web.conf 后按需修改；本模板纳入仓库，本地配置不提交。
# 服务配置以此文件为准，不接受命令行端口或服务环境变量覆盖。
# 端口范围：1–65535。
PI_WEB_PORT=8024
PI_WEB_HOST=0.0.0.0
PI_WEB_PASSWORD=''

# 可选：留空或不填写时按端口自动生成绝对路径。
# PI_WEB_DATA_DIR='/absolute/path/to/state'
# PI_WEB_RUN_DIR='/absolute/path/to/run'
# PI_WEB_SESSIOND_SOCKET='/absolute/path/to/sessiond.sock'

# 可选：update 的下载、安装和测试设置。
# PI_WEB_UPSTREAM_URL=https://github.com/jmfederico/pi-web.git
# PI_WEB_INSTALL_ROOT="/absolute/path/to/releases" # 默认仓库 data/pi-web-releases
# PI_WEB_TEST_MAX_WORKERS=4
# PI_WEB_TEST_TIMEOUT_MS=30000
